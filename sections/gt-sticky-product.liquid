{%- comment -%}
  Structural equivalent of Vusi's seed-sticky-product component: a fixed
  bottom-right pill that expands into a small "quick shop" panel once the
  visitor scrolls past a threshold, and hides again near the footer. Vusi's
  version also does a word-by-word title reveal and a close button when
  dismissible; this instance of theirs ships non-dismissible with no close
  button, which is what's replicated here. Links to GhostTint's real (and
  only) product — no catalog assumption, since GhostTint has one product.
{%- endcomment -%}
{%- style -%}
  .gt-sticky-{{ section.id }} {
    --gt-sp-bg: rgba(98, 98, 98, 0.35);
    --gt-sp-text: #ffffff;
    --gt-sp-button-bg: #f8f8f8;
    --gt-sp-button-text: #4a4a4a;
    --gt-sp-button-hover: #e8e8e8;
    --gt-sp-width: 480px;
    --gt-sp-side: 16px;
    --gt-sp-bottom: 16px;
    --gt-sp-radius: 100px;
    --gt-sp-image: 48px;
    --gt-sp-blur: 19px;
    --gt-sp-duration: 900ms;
    position: fixed;
    inset: auto var(--gt-sp-side) calc(var(--gt-sp-bottom) + env(safe-area-inset-bottom, 0px)) auto;
    width: min(var(--gt-sp-width), calc(100% - var(--gt-sp-side) * 2));
    z-index: 100;
    color: var(--gt-sp-text);
    border-radius: var(--gt-sp-radius);
    overflow: clip;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--gt-sp-duration) cubic-bezier(0, 0, 0.2, 1), visibility var(--gt-sp-duration);
  }

  .gt-sticky-{{ section.id }}[data-visible="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .gt-sticky-{{ section.id }} * {
    box-sizing: border-box;
  }

  .gt-sticky-{{ section.id }} .gt-sp__surface {
    position: absolute;
    inset: 0;
    background: var(--gt-sp-bg);
    backdrop-filter: blur(var(--gt-sp-blur));
    -webkit-backdrop-filter: blur(var(--gt-sp-blur));
    border-radius: var(--gt-sp-radius);
    pointer-events: none;
  }

  .gt-sticky-{{ section.id }} .gt-sp__panel {
    position: relative;
    padding: 7px;
  }

  .gt-sticky-{{ section.id }} .gt-sp__main {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .gt-sticky-{{ section.id }} .gt-sp__image-wrap {
    flex: 0 0 var(--gt-sp-image);
    width: var(--gt-sp-image);
    height: var(--gt-sp-image);
    border-radius: 50%;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.15);
  }

  .gt-sticky-{{ section.id }} .gt-sp__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gt-sticky-{{ section.id }} .gt-sp__copy {
    flex: 1 1 0%;
    min-width: 0;
    padding: 2px 0;
  }

  .gt-sticky-{{ section.id }} .gt-sp__title {
    margin: 0;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .gt-sticky-{{ section.id }} .gt-sp__button {
    appearance: none;
    min-height: 48px;
    border: 0;
    padding: 12px 24px;
    border-radius: var(--gt-sp-radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--gt-sp-button-bg);
    color: var(--gt-sp-button-text);
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    flex: 0 0 auto;
    transition: background 0.16s;
  }

  .gt-sticky-{{ section.id }} .gt-sp__button:hover {
    background: var(--gt-sp-button-hover);
  }

  @media screen and (max-width: 749px) {
    .gt-sticky-{{ section.id }} {
      width: calc(100% - var(--gt-sp-side) * 2);
      max-width: var(--gt-sp-width);
    }

    .gt-sticky-{{ section.id }} .gt-sp__title {
      font-size: 14px;
    }

    .gt-sticky-{{ section.id }} .gt-sp__image-wrap {
      flex-basis: 36px;
      width: 36px;
      height: 36px;
    }

    .gt-sticky-{{ section.id }} .gt-sp__button {
      min-height: 36px;
      padding: 8px 16px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gt-sticky-{{ section.id }} {
      transition: none;
    }
  }

  @media print {
    .gt-sticky-{{ section.id }} {
      display: none !important;
    }
  }
{%- endstyle -%}

{%- assign gt_sp_product = all_products[section.settings.product_handle] -%}
{%- if gt_sp_product != blank -%}
  <div
    class="gt-sticky-{{ section.id }}"
    data-gt-sticky-product
    data-scroll-desktop="{{ section.settings.scroll_desktop }}"
    data-scroll-mobile="{{ section.settings.scroll_mobile }}"
    data-visible="false"
  >
    <div class="gt-sp__surface" aria-hidden="true"></div>
    <aside class="gt-sp__panel" aria-label="Featured product">
      <div class="gt-sp__main">
        {%- if gt_sp_product.featured_image != blank -%}
          <div class="gt-sp__image-wrap">
            {{ gt_sp_product.featured_image | image_url: width: 96 | image_tag: class: 'gt-sp__image', loading: 'lazy', alt: gt_sp_product.title }}
          </div>
        {%- endif -%}
        <div class="gt-sp__copy">
          <p class="gt-sp__title">{{ gt_sp_product.title }}</p>
        </div>
        <a class="gt-sp__button" href="{{ gt_sp_product.url }}">{{ section.settings.button_label | default: 'Shop Now' }}</a>
      </div>
    </aside>
  </div>

  <script>
    (function () {
      var el = document.currentScript.previousElementSibling;
      if (!el || !el.hasAttribute('data-gt-sticky-product')) return;

      var isMobile = window.matchMedia('(max-width: 749px)').matches;
      var threshold = parseInt(el.getAttribute(isMobile ? 'data-scroll-mobile' : 'data-scroll-desktop'), 10) || 800;
      var footer = document.querySelector('footer, #shopify-section-footer');
      var footerVisible = false;

      if (footer && 'IntersectionObserver' in window) {
        var footerObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            footerVisible = entry.isIntersecting;
            update();
          });
        }, { threshold: 0 });
        footerObserver.observe(footer);
      }

      function update() {
        var pastThreshold = window.scrollY > threshold;
        el.setAttribute('data-visible', pastThreshold && !footerVisible ? 'true' : 'false');
      }

      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "GT Sticky product",
  "settings": [
    {
      "type": "text",
      "id": "product_handle",
      "label": "Product handle",
      "default": "ghosttint",
      "info": "GhostTint sells one product with bundle-quantity variants, so this points at that single product rather than a picker."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "number",
      "id": "scroll_desktop",
      "label": "Show after scrolling (desktop, px)",
      "default": 800
    },
    {
      "type": "number",
      "id": "scroll_mobile",
      "label": "Show after scrolling (mobile, px)",
      "default": 600
    }
  ]
}
{% endschema %}
