{%- style -%}
  .gt-su-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: 64px 40px;
  }

  .gt-su-{{ section.id }} .gt-su__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .gt-su-{{ section.id }} .gt-su__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: {{ section.settings.heading_color }};
  }

  .gt-su-{{ section.id }} .gt-su__desc {
    margin: 10px 0 0;
    font-family: var(--font-body-family);
    font-size: 15px;
    color: {{ section.settings.desc_color }};
  }

  .gt-su-{{ section.id }} .gt-su__form-wrap {
    max-width: 480px;
    margin: 24px auto 0;
  }

  .gt-su-{{ section.id }} .gt-su__field-wrapper {
    position: relative;
  }

  .gt-su-{{ section.id }} .gt-su__input {
    width: 100%;
    padding: 14px 52px 14px 20px;
    border-radius: 100px;
    border: 1px solid {{ section.settings.input_border }};
    background: {{ section.settings.input_background }};
    color: {{ section.settings.heading_color }};
    font-family: var(--font-body-family);
    font-size: 15px;
  }

  .gt-su-{{ section.id }} .gt-su__input::placeholder,
  .gt-su-{{ section.id }} .gt-su__label {
    color: {{ section.settings.desc_color }};
  }

  .gt-su-{{ section.id }} .gt-su__label {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-body-family);
    font-size: 15px;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .gt-su-{{ section.id }} .gt-su__input:focus + .gt-su__label,
  .gt-su-{{ section.id }} .gt-su__input:not(:placeholder-shown) + .gt-su__label {
    opacity: 0;
  }

  .gt-su-{{ section.id }} .gt-su__submit {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: {{ section.settings.button_color }};
  }

  .gt-su-{{ section.id }} .gt-su__submit svg {
    width: 16px;
    height: 16px;
  }

  .gt-su-{{ section.id }} .gt-su__message {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
    font-family: var(--font-body-family);
    font-size: 13px;
  }

  .gt-su-{{ section.id }} .gt-su__message--success {
    color: {{ section.settings.success_color }};
  }

  .gt-su-{{ section.id }} .gt-su__message--error {
    color: {{ section.settings.error_color }};
  }

  .gt-su-{{ section.id }} .gt-su__reveal {
    filter: blur(10px);
    transition: filter 0.4s ease-out;
  }

  .gt-su-{{ section.id }}.gt-su--in .gt-su__reveal {
    filter: blur(0);
  }

  .gt-su-{{ section.id }} .gt-su__reveal:nth-child(1) { transition-delay: 0ms; }
  .gt-su-{{ section.id }} .gt-su__reveal:nth-child(2) { transition-delay: 90ms; }
  .gt-su-{{ section.id }} .gt-su__reveal:nth-child(3) { transition-delay: 180ms; }

  @media (prefers-reduced-motion: reduce) {
    .gt-su-{{ section.id }} .gt-su__reveal {
      filter: none;
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .gt-su-{{ section.id }} {
      padding: 40px 16px;
    }
  }
{%- endstyle -%}

<section class="gt-su-{{ section.id }}" data-gt-signup>
  <div class="gt-su__inner">
    <h2 class="gt-su__heading gt-su__reveal">{{ section.settings.heading }}</h2>
    {%- if section.settings.description != blank -%}
      <p class="gt-su__desc gt-su__reveal">{{ section.settings.description }}</p>
    {%- endif -%}
    <div class="gt-su__form-wrap gt-su__reveal">
      {% form 'customer', class: 'gt-su__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="gt-su__field-wrapper">
          <input
            id="GtSignup-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="gt-su__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder=" "
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="GtSignup-error-{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="GtSignup-success-{{ section.id }}"
            {% endif %}
            required
          >
          <label class="gt-su__label" for="GtSignup-{{ section.id }}">{{ section.settings.input_placeholder | default: 'Enter your email' }}</label>
          <button type="submit" class="gt-su__submit" name="commit" aria-label="{{ section.settings.button_label | default: 'Subscribe' }}">
            {% render 'icon-arrow' %}
          </button>
        </div>
        {%- if form.errors -%}
          <p class="gt-su__message gt-su__message--error" id="GtSignup-error-{{ section.id }}">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="gt-su__message gt-su__message--success" id="GtSignup-success-{{ section.id }}" tabindex="-1" autofocus>
            {{ 'newsletter.success' | t }}
          </p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.currentScript.previousElementSibling;
    if (!section || !section.hasAttribute('data-gt-signup')) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      section.classList.add('gt-su--in');
      return;
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            section.classList.add('gt-su--in');
            observer.unobserve(section);
          }
        });
      }, { threshold: 0.2 });
      observer.observe(section);
    } else {
      section.classList.add('gt-su--in');
    }
  })();
</script>

{% schema %}
{
  "name": "GT Signup (Vusi layout)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Join our email list for exclusive offers and the latest news."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button aria-label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / input text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description / placeholder",
      "default": "#858585"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "Input border",
      "default": "#b5b5b5"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Submit icon color",
      "default": "#575757"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success message color",
      "default": "#246446"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error message color",
      "default": "#b42318"
    }
  ],
  "presets": [
    {
      "name": "GT Signup (Vusi layout)"
    }
  ]
}
{% endschema %}
