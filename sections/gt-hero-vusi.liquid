{%- style -%}
  .gt-vh-{{ section.id }} {
    position: relative;
    min-height: 100vh;
    display: block;
    overflow: hidden;
    background: {{ section.settings.background_color }};
  }

  .gt-vh-{{ section.id }} .gt-vh__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.media_focal_point }};
  }

  .gt-vh-{{ section.id }} .gt-vh__media-wrap {
    position: absolute;
    inset: 0;
  }

  .gt-vh-{{ section.id }} .gt-vh__media-wrap--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .gt-vh-{{ section.id }} .gt-vh__media-wrap--desktop {
      display: none;
    }

    .gt-vh-{{ section.id }} .gt-vh__media-wrap--mobile {
      display: block;
    }
  }

  .gt-vh-{{ section.id }} .gt-vh__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0) 35%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
  }

  .gt-vh-{{ section.id }} .gt-vh__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    min-height: 100vh;
    padding: 100px 40px 80px;
    max-width: 900px;
  }

  .gt-vh-{{ section.id }} .gt-vh__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(34px, 5.6vw, 80px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: {{ section.settings.heading_bold_color }};
  }

  .gt-vh-{{ section.id }} .gt-vh__heading .gt-vh__heading--muted,
  .gt-vh-{{ section.id }} .gt-vh__heading .gt-vh__heading--bold {
    display: block;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    font-family: inherit;
  }

  .gt-vh-{{ section.id }} .gt-vh__heading .gt-vh__heading--muted {
    color: {{ section.settings.heading_muted_color }};
  }

  .gt-vh-{{ section.id }} .gt-vh__heading .gt-vh__heading--bold {
    color: {{ section.settings.heading_bold_color }};
  }

  .gt-vh-{{ section.id }} .gt-vh__desc {
    margin: 24px 0 0;
    font-family: var(--font-body-family);
    font-size: 18px;
    line-height: 1.4;
    color: {{ section.settings.desc_color }};
    max-width: 620px;
  }

  .gt-vh-{{ section.id }} .gt-vh__btn {
    display: inline-flex;
    align-items: center;
    margin-top: 32px;
    padding: 15px 40px;
    border-radius: 100px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    font-family: var(--font-body-family);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    border: none;
    transition: background-color 0.2s, color 0.2s;
  }

  .gt-vh-{{ section.id }} .gt-vh__btn:hover {
    background-color: {{ section.settings.button_hover_bg }};
  }

  @media screen and (max-width: 749px) {
    .gt-vh-{{ section.id }} .gt-vh__content {
      padding: 80px 20px 56px;
      max-width: none;
    }

    .gt-vh-{{ section.id }} .gt-vh__desc {
      font-size: 16px;
      margin-top: 16px;
    }

    .gt-vh-{{ section.id }} .gt-vh__btn {
      margin-top: 24px;
      padding: 13px 32px;
      font-size: 15px;
    }
  }
{%- endstyle -%}

<section class="gt-vh-{{ section.id }} gt-hero-vusi" data-pause-offscreen="true" data-respect-motion="true" data-desktop-media="{% if section.settings.video_url != blank %}video{% else %}image{% endif %}" data-mobile-media="{% if section.settings.mobile_video_url != blank or section.settings.video_url != blank %}video{% else %}image{% endif %}">
  {%- comment -%}
    Desktop media. Hidden on mobile via CSS when a distinct mobile_video_url/
    mobile_poster_image is set (matches Vusi's own data-desktop-media /
    data-mobile-media split); falls back to the same desktop asset on mobile
    when no mobile-specific media is configured, rather than inventing one.
  {%- endcomment -%}
  {%- if section.settings.mobile_video_url != blank or section.settings.mobile_poster_image != blank -%}
    <div class="gt-vh__media-wrap gt-vh__media-wrap--desktop">
      {%- if section.settings.video_url != blank -%}
        <video class="gt-vh__media" autoplay muted loop playsinline preload="metadata" poster="{{ section.settings.poster_image | image_url: width: 1920 }}" data-gt-hero-video>
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.poster_image != blank -%}
        {{ section.settings.poster_image | image_url: width: 1920 | image_tag: class: 'gt-vh__media', loading: 'eager', fetchpriority: 'high' }}
      {%- endif -%}
    </div>
    <div class="gt-vh__media-wrap gt-vh__media-wrap--mobile">
      {%- if section.settings.mobile_video_url != blank -%}
        <video class="gt-vh__media" autoplay muted loop playsinline preload="metadata" poster="{{ section.settings.mobile_poster_image | default: section.settings.poster_image | image_url: width: 1200 }}" data-gt-hero-video>
          <source src="{{ section.settings.mobile_video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.mobile_poster_image != blank -%}
        {{ section.settings.mobile_poster_image | image_url: width: 1200 | image_tag: class: 'gt-vh__media', loading: 'eager', fetchpriority: 'high' }}
      {%- endif -%}
    </div>
  {%- elsif section.settings.video_url != blank -%}
    <video
      class="gt-vh__media"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="{{ section.settings.poster_image | image_url: width: 1920 }}"
      data-gt-hero-video
    >
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {%- elsif section.settings.poster_image != blank -%}
    {{
      section.settings.poster_image
      | image_url: width: 1920
      | image_tag: class: 'gt-vh__media', loading: 'eager', fetchpriority: 'high'
    }}
  {%- endif -%}

  <div class="gt-vh__overlay"></div>

  <div class="gt-vh__content">
    <h1 class="gt-vh__heading">
      {%- if section.settings.heading_muted != blank -%}
        <span class="gt-vh__heading--muted">{{ section.settings.heading_muted }}</span>
        <span class="gt-vh__heading--bold">{{ section.settings.heading_bold }}</span>
      {%- else -%}
        {{ section.settings.heading_bold }}
      {%- endif -%}
    </h1>
    {%- if section.settings.description != blank -%}
      <p class="gt-vh__desc">{{ section.settings.description }}</p>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="gt-vh__btn">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var prev = document.currentScript.previousElementSibling;
    var section = prev && prev.classList.contains('gt-hero-vusi') ? prev : null;
    if (!section) return;
    var mediaVideos = section.querySelectorAll('[data-gt-hero-video]');
    if (!mediaVideos.length) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      mediaVideos.forEach(function (v) {
        v.removeAttribute('autoplay');
        v.pause();
      });
      return;
    }

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          mediaVideos.forEach(function (v) {
            if (v.offsetParent === null) return; // skip the hidden (desktop/mobile) media
            if (entry.isIntersecting) {
              v.play().catch(function () {});
            } else {
              v.pause();
            }
          });
        });
      }, { threshold: 0.1 });
      observer.observe(section);
    }
  })();
</script>

{% schema %}
{
  "name": "GT Hero (Vusi layout)",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Background video URL (mp4)",
      "info": "Direct CDN URL to an mp4 file. Falls back to the poster image if left blank."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster / fallback image"
    },
    {
      "type": "text",
      "id": "mobile_video_url",
      "label": "Mobile background video URL (mp4)",
      "info": "Optional. Leave blank to reuse the desktop video/image on mobile. Vusi itself serves distinct desktop vs. mobile hero media."
    },
    {
      "type": "image_picker",
      "id": "mobile_poster_image",
      "label": "Mobile poster / fallback image"
    },
    {
      "type": "select",
      "id": "media_focal_point",
      "label": "Focal point",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_muted",
      "label": "Heading — muted lead-in",
      "info": "Rendered at 50% opacity, matching Vusi's two-tone heading pattern. Leave blank for a single-tone heading."
    },
    {
      "type": "text",
      "id": "heading_bold",
      "label": "Heading — emphasized",
      "default": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background (shown before media loads)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_muted_color",
      "label": "Heading — muted lead-in color",
      "default": "#bfbfbf"
    },
    {
      "type": "color",
      "id": "heading_bold_color",
      "label": "Heading — emphasized color",
      "default": "#e9e9e9"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description color",
      "default": "#f0f0f0"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#f5f6f6"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#e5e6e6"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "GT Hero (Vusi layout)"
    }
  ]
}
{% endschema %}
