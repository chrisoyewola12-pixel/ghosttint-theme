{{ 'gt-pdp.css' | asset_url | stylesheet_tag }}
{{ 'gt-install-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gt-pdp.js' | asset_url }}" defer></script>
<script src="{{ 'gt-install-guide.js' | asset_url }}" defer></script>

<div class="gt">
  <div class="gt__wrap gt__wrap--narrow gt-section">

    {%- if section.settings.eyebrow != blank -%}
      <p class="gt-eyebrow" style="text-align:center;">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="gt-h2" style="text-align:center; margin-left:auto; margin-right:auto;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- assign video_blocks = section.blocks | where: 'type', 'video_step' -%}

    {%- if video_blocks.size > 0 -%}
      <div class="gt-ig" data-gt-ig>
        <div class="gt-ig__track" data-gt-ig-track>
          {%- for block in video_blocks -%}
            <div
              class="gt-ig-card"
              data-gt-ig-card
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.tag != blank -%}
                <span class="gt-ig-card__tag">{{ block.settings.tag }}</span>
              {%- endif -%}

              {%- if block.settings.video_url != blank -%}
                <video
                  class="gt-ig-card__video"
                  data-gt-ig-video
                  loop
                  muted
                  playsinline
                  preload="none"
                  {%- if block.settings.poster != blank %}
                  poster="{{ block.settings.poster | image_url: width: 800 }}"
                  {%- endif %}
                >
                  <source data-src="{{ block.settings.video_url }}" type="video/mp4">
                </video>

                <div class="gt-ig-card__controls" data-gt-ig-controls>
                  <button type="button" class="gt-ig-card__btn" data-gt-ig-play aria-label="Play video">
                    {%- render 'icon-play' -%}
                    {%- render 'icon-pause' -%}
                  </button>
                  <input type="range" class="gt-ig-card__scrub" data-gt-ig-scrub min="0" max="100" value="0" step="0.1" aria-label="Seek">
                  <button type="button" class="gt-ig-card__btn" data-gt-ig-mute aria-label="Unmute video">
                    <svg class="gt-ig-icon gt-ig-icon--muted" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/><path d="M16.5 8.5l4 4m0-4l-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    <svg class="gt-ig-icon gt-ig-icon--sound" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor"/><path d="M16.5 8.8c1 .9 1.6 2 1.6 3.2s-.6 2.3-1.6 3.2M19 6.8c1.9 1.6 3 3.6 3 5.2s-1.1 3.6-3 5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  </button>
                </div>
              {%- else -%}
                <div class="gt-ig-card__placeholder">
                  {%- render 'gt-wiring-diagram', ratio: '9/16' -%}
                  <p class="gt-ig-card__soon">{{ block.settings.placeholder_text | default: 'Video coming soon' }}</p>
                </div>
              {%- endif -%}

              {%- if block.settings.caption != blank -%}
                <p class="gt-ig-card__caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if video_blocks.size > 1 -%}
          <div class="gt-ig__dots" data-gt-ig-dots role="tablist" aria-label="Installation steps">
            {%- for block in video_blocks -%}
              <button type="button" class="gt-ig__dot" data-gt-ig-dot role="tab" aria-label="{{ block.settings.tag | default: 'Step' }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign written_blocks = section.blocks | where: 'type', 'written_step' -%}
    {%- if written_blocks.size > 0 -%}
      <div class="gt-ig-written">
        {%- comment -%}
          VUSI's own "Written Instructions" button is a plain link to a
          static PDF (confirmed by inspecting its href), not a modal or an
          inline panel — matched here the same way rather than guessed.
        {%- endcomment -%}
        <a
          href="{{ 'gt-installation-guide.pdf' | asset_url }}"
          class="gt-btn gt-btn--ghost gt-ig-written__toggle"
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.written_button_label | default: 'Written Instructions' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "GT · Installation guide",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT'S DONE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Installation" },
    { "type": "text", "id": "written_button_label", "label": "Written instructions button label", "default": "Written Instructions" }
  ],
  "blocks": [
    {
      "type": "video_step",
      "name": "Video step",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "info": "Short label shown on the card, e.g. GLASS or WIRING." },
        { "type": "text", "id": "video_url", "label": "Video URL", "info": "Direct .mp4 URL. Leave blank to show an animated placeholder diagram instead (useful while you don't have footage yet)." },
        { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Optional. Shown before the video loads." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "placeholder_text", "label": "Placeholder text", "default": "Video coming soon", "info": "Shown when Video URL is blank." }
      ]
    },
    {
      "type": "written_step",
      "name": "Written step",
      "settings": [
        { "type": "text", "id": "image_url", "label": "Image URL" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GT · Installation guide",
      "blocks": [
        { "type": "video_step", "settings": { "tag": "GLASS", "video_url": "https://cdn.shopify.com/videos/c/vp/3af1d9524a7e4465ba8e1e1b2cbb3f93/3af1d9524a7e4465ba8e1e1b2cbb3f93.HD-1080p-2.5Mbps-94452066.mp4", "caption": "Mount GhostTint onto the glass" } },
        { "type": "video_step", "settings": { "tag": "WIRING", "video_url": "", "placeholder_text": "Wiring video coming soon", "caption": "Connect the control box to power" } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0945/8905/9420/files/ChatGPT_Image_Dec_18_2025_03_16_03_PM.png?v=1766070985", "title": "Step 1 — Clean the Window", "text": "Use a microfiber cloth to clean the glass thoroughly for best adhesion." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0945/8905/9420/files/ChatGPT_Image_Dec_18_2025_03_19_00_PM.png?v=1766071153", "title": "Step 2 — Measurement", "text": "Measure the window and position the tint film accurately before cutting." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0945/8905/9420/files/ChatGPT_Image_Dec_18_2025_03_20_13_PM.png?v=1766071240", "title": "Step 3 — Trim Excess Tint Film", "text": "Trim the film carefully to match your window shape for a perfect fit." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0945/8905/9420/files/ChatGPT_Image_Dec_18_2025_03_23_52_PM.png?v=1766071460", "title": "Step 4 — Remove the Release Liner", "text": "Peel off the liner to expose the adhesive side of the tint film." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0945/8905/9420/files/ChatGPT_Image_Dec_18_2025_03_30_54_PM.png?v=1766071879", "title": "Step 5 — Position the Tint Film", "text": "Place the film onto the glass and adjust it into the correct position." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0929/1232/0893/files/ChatGPT_Image_Dec_18_2025_03_54_03_PM.png?v=1766073259", "title": "Step 6 — Scrape & Remove Bubbles", "text": "Use a squeegee to push out any air bubbles for a smooth finish." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0929/1232/0893/files/ChatGPT_Image_Dec_18_2025_03_54_57_PM.png?v=1766073314", "title": "Step 7 — Remove Door Panel", "text": "Carefully remove the door panel to access the power supply and wiring." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0929/1232/0893/files/ChatGPT_Image_Dec_18_2025_03_55_39_PM.png?v=1766073356", "title": "Step 8 — Connect Tint to ACC Power Supply", "text": "Connect the tint system's wiring to the ACC circuit for power." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0929/1232/0893/files/ChatGPT_Image_Dec_18_2025_04_00_19_PM.png?v=1766073638", "title": "Step 9 — Install Door Panel Back", "text": "Screw the panel back on securely after completing wiring." } },
        { "type": "written_step", "settings": { "image_url": "https://cdn.shopify.com/s/files/1/0929/1232/0893/files/ChatGPT_Image_Dec_18_2025_04_00_22_PM.png?v=1766073638", "title": "Step 10 — Smart Tint Ready to Use", "text": "Your smart tint is now installed — test with remote/ACC to confirm smooth operation." } }
      ]
    }
  ]
}
{% endschema %}
