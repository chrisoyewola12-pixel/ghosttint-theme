<script>
  (function() {
    class GhostTintsBenefits{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const grid = this.querySelector('.ai-benefits-grid-{{ ai_gen_id }}');
        
        if (window.innerWidth <= 749 && grid) {
          grid.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: true });
        }
      }

      handleTouchStart(e) {
        const grid = e.currentTarget;
        if (grid.scrollWidth > grid.clientWidth) {
          grid.style.cursor = 'grab';
        }
      }
    }

    customElements.define('ghost-tints-benefits-{{ ai_gen_id }}', GhostTintsBenefits{{ ai_gen_id }});
  })();
</script>

