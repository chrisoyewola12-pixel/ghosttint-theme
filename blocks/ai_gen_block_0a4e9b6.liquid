{% doc %}
  @prompt
    Generate a compact responsive Shopify benefits section for Ghost Tints. Use a near-black background with warm-white text, thin graphite dividers and restrained cyan line icons.
    
    Create three editable blocks with an icon, heading and optional short description. Use these defaults:
    
    1. “Instant Privacy”
    2. “SPD Technology”
    3. “Vehicle Integrated”
    
    Display all three blocks in one horizontal row on desktop and stack or horizontally scroll them cleanly on mobile. Keep the section shallow and premium, with generous horizontal spacing but minimal vertical padding.
    
    Add theme-editor controls for colors, icons, text, spacing and divider visibility. Do not add unsupported technical claims, animations, reviews or ratings. Make the icons decorative where appropriate and ensure all text meets accessible contrast standards.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.item_spacing }}px;
    align-items: center;
  }

  .ai-benefit-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.content_gap }}px;
    padding: {{ block.settings.item_padding }}px;
    position: relative;
  }

  .ai-benefit-item-{{ ai_gen_id }}:not(:last-child)::after {
    {% if block.settings.show_dividers %}
      content: '';
      position: absolute;
      right: calc(-{{ block.settings.item_spacing }}px / 2);
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: {{ block.settings.divider_height }}%;
      background-color: {{ block.settings.divider_color }};
    {% endif %}
  }

  .ai-benefit-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-benefit-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-benefit-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-benefit-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_vertical_padding }}px {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-benefits-grid-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'stack' %}
        grid-template-columns: 1fr;
        gap: {{ block.settings.mobile_item_spacing }}px;
      {% elsif block.settings.mobile_layout == 'scroll' %}
        grid-template-columns: repeat(3, minmax(250px, 1fr));
        gap: {{ block.settings.mobile_item_spacing }}px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      {% endif %}
    }

    .ai-benefits-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-benefit-item-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'scroll' %}
        scroll-snap-align: start;
      {% endif %}
    }

    .ai-benefit-item-{{ ai_gen_id }}:not(:last-child)::after {
      {% if block.settings.mobile_layout == 'stack' %}
        display: none;
      {% endif %}
    }

    .ai-benefit-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-benefit-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-benefit-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_size }}px;
    }
  }
{% endstyle %}

