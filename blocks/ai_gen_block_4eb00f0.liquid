{% doc %}
  @prompt
    Create a responsive “Specs” section that matches the reference layout. Desktop: use a two-column layout with a bold navy headline “The Specs” at the top-left (#002B5B). Below the headline display specs in a clean two-column text grid:
    
    Left column:
    Bag Count: ~25 bags per ring
    Material: Durable, leak-resistant polymer film
    Dimensions: 10.5" outer diameter (snap-fit design)
    Disposal: Fully recyclable ring frame
    
    Right column:
    1-Pack Supply: ~25 bags total (lasts ~1 month)
    Fit: Designed for Royal Bin™ Signature 17L and Lite 13L
    Odor Control: Multi-layer bag design helps trap smells
    Returns: 30-Day Money Back Guarantee
    
    On desktop, place a large product image upload placeholder to the right of the text grid. Image must scale naturally without cropping and vertically align to the height of the specs block. No borders or frames.
    
    Mobile layout: stack vertically. Show the “The Specs” heading first, then the entire specs grid in a single column list (each label above its value), followed by the full-width product image below (max height ~50–60vh, maintain aspect ratio, no cropping). Keep spacing generous between items.
    
    General styling: white background (#FFFFFF), navy headings (#002B5B), dark gray body text (#555555), modern sans-serif font, clean editorial spacing, no shadows or borders.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-specs-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_desktop }}px 20px;
  }

  .ai-specs-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-specs-layout-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .ai-specs-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ai-specs-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .ai-specs-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 40px;
  }

  .ai-specs-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-specs-label-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
  }

  .ai-specs-value-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: 400;
    margin: 0;
    line-height: 1.6;
  }

  .ai-specs-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-specs-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-specs-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 400px;
  }

  .ai-specs-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-specs-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-specs-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 20px;
    }

    .ai-specs-layout-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-specs-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-specs-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-specs-image-placeholder-{{ ai_gen_id }} {
      min-height: 50vh;
      max-height: 60vh;
    }

    .ai-specs-image-{{ ai_gen_id }} {
      max-height: 60vh;
      object-fit: contain;
    }
  }
{% endstyle %}

<div class="ai-specs-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-specs-container-{{ ai_gen_id }}">
    <div class="ai-specs-layout-{{ ai_gen_id }}">
      <div class="ai-specs-content-{{ ai_gen_id }}">
        <h2 class="ai-specs-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        
        <div class="ai-specs-grid-{{ ai_gen_id }}">
          {% if block.settings.spec_1_label != blank %}
            <div class="ai-specs-item-{{ ai_gen_id }}">
              <p class="ai-specs-label-{{ ai_gen_id }}">{{ block.settings.spec_1_label }}</p>
              <p class="ai-specs-value-{{ ai_gen_id }}">{{ block.settings.spec_1_value }}</p>
            </div>
          {% endif %}

          {% if block.settings.spec_2_label != blank %}
            <div class="ai-specs-item-{{ ai_gen_id }}">
              <p class="ai-specs-label-{{ ai_gen_id }}">{{ block.settings.spec_2_label }}</p>
              <p class="ai-specs-value-{{ ai_gen_id }}">{{ block.settings.spec_2_value }}</p>
            </div>
          {% endif %}

          {% if block.settings.spec_3_label != blank %}
            <div class="ai-specs-item-{{ ai_gen_id }}">
              <p class="ai-specs-label-{{ ai_gen_id }}">{{ block.settings.spec_3_label }}</p>
              <p class="ai-specs-value-{{ ai_gen_id }}">{{ block.settings.spec_3_value }}</p>
            </div>
          {% endif %}

          {% if block.settings.spec_4_label != blank %}
            <div class="ai-specs-item-{{ ai_gen_id }}">
              <p class="ai-specs-label-{{ ai_gen_id }}">{{ block.settings.spec_4_label }}</p>
              <p class="ai-specs-value-{{ ai_gen_id }}">{{ block.settings.spec_4_value }}</p>
            </div>
          {% endif %}

          {% if block.settings.spec_5_label != blank %}
            <div class="ai-specs-item-{{ ai_gen_id }}">
              <p class="ai-specs-label-{{ ai_gen_id }}">{{ block.settings.spec_5_label }}</p>
              <p class="ai-specs-value-{{ ai_gen_id }}">{{ block.settings.spec_5_value }}</p>
            </div>
          {% endif %}

          {% if block.settings.spec_6_label != blank %}
            <div class="ai-specs-item-{{ ai_gen_id }}">
              <p class="ai-specs-label-{{ ai_gen_id }}">{{ block.settings.spec_6_label }}</p>
              <p class="ai-specs-value-{{ ai_gen_id }}">{{ block.settings.spec_6_value }}</p>
            </div>
          {% endif %}

          {% if block.settings.spec_7_label != blank %}
            <div class="ai-specs-item-{{ ai_gen_id }}">
              <p class="ai-specs-label-{{ ai_gen_id }}">{{ block.settings.spec_7_label }}</p>
              <p class="ai-specs-value-{{ ai_gen_id }}">{{ block.settings.spec_7_value }}</p>
            </div>
          {% endif %}

          {% if block.settings.spec_8_label != blank %}
            <div class="ai-specs-item-{{ ai_gen_id }}">
              <p class="ai-specs-label-{{ ai_gen_id }}">{{ block.settings.spec_8_label }}</p>
              <p class="ai-specs-value-{{ ai_gen_id }}">{{ block.settings.spec_8_value }}</p>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-specs-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.product_image %}
          <img
            src="{{ block.settings.product_image | image_url: width: 1200 }}"
            alt="{{ block.settings.product_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product_image.width }}"
            height="{{ block.settings.product_image.height }}"
            class="ai-specs-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-specs-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-specs-empty-state-{{ ai_gen_id }}">
              Add a product image
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

