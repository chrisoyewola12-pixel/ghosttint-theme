{% doc %}
  @prompt
    Generate a responsive Shopify section titled "TAKE A CLOSER LOOK." This section will be placed immediately after the existing Product Information section. Do not create a product form, variant selector, price, quantity control, Add to Cart button, Buy It Now button, upsell or free-gift logic. Create one large editable animated-WebP card:
    
    Heading: "INSTANT TINT CONTROL"
    Copy: "Adjust your window from deep privacy to open clarity using the remote."
    
    The card must support:
    
    Animated WebP image picker
    Separate optional mobile image
    Heading
    Description
    Alt text
    Image focal point
    
    Display the card centered on desktop and mobile. Use an obsidian-black background, warm-white text, thin graphite borders and restrained cyan accents. Do not add play icons, video controls, progress bars or hover overlays. Preserve WebP animation naturally.
    
    Add settings for image ratio, card gap, content width, section spacing and background color. Use responsive Shopify image rendering and lazy-load the assets.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-closer-look-section-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_spacing_top }}px 0 {{ block.settings.section_spacing_bottom }}px;
    width: 100%;
  }

  .ai-closer-look-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-closer-look-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-align: center;
    margin: 0 0 {{ block.settings.card_gap }}px;
    font-size: 32px;
    letter-spacing: 2px;
  }

  .ai-closer-look-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 8px;
    overflow: hidden;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-closer-look-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_ratio }}%;
    overflow: hidden;
  }

  .ai-closer-look-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_focal_point }};
  }

  .ai-closer-look-content-{{ ai_gen_id }} {
    padding: 32px 24px;
    text-align: center;
  }

  .ai-closer-look-card-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    font-size: 24px;
    letter-spacing: 1.5px;
  }

  .ai-closer-look-card-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

  .ai-closer-look-card-description-{{ ai_gen_id }} a {
    color: {{ block.settings.accent_color }};
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .ai-closer-look-card-description-{{ ai_gen_id }} a:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-closer-look-heading-{{ ai_gen_id }} {
      font-size: 24px;
      margin-bottom: {{ block.settings.card_gap | times: 0.75 }}px;
    }

    .ai-closer-look-card-heading-{{ ai_gen_id }} {
      font-size: 20px;
    }

    .ai-closer-look-card-description-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-closer-look-content-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .ai-closer-look-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_spacing_top | times: 0.75 }}px 0 {{ block.settings.section_spacing_bottom | times: 0.75 }}px;
    }
  }
{% endstyle %}

<div class="ai-closer-look-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-closer-look-container-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-closer-look-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    <div class="ai-closer-look-card-{{ ai_gen_id }}">
      <div class="ai-closer-look-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.mobile_image != blank and block.settings.image != blank %}
          <picture>
            <source
              media="(max-width: 749px)"
              srcset="{{ block.settings.mobile_image | image_url: width: 800 }}"
            >
            <img
              src="{{ block.settings.image | image_url: width: 1400 }}"
              alt="{{ block.settings.image_alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="ai-closer-look-image-{{ ai_gen_id }}"
            >
          </picture>
        {% elsif block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 1400 }}"
            alt="{{ block.settings.image_alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-closer-look-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-closer-look-image-{{ ai_gen_id }}" style="background-color: #1a1a1a; display: flex; align-items: center; justify-content: center;">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-closer-look-content-{{ ai_gen_id }}">
        {% if block.settings.card_heading != blank %}
          <h3 class="ai-closer-look-card-heading-{{ ai_gen_id }}">{{ block.settings.card_heading }}</h3>
        {% endif %}

        {% if block.settings.card_description != blank %}
          <div class="ai-closer-look-card-description-{{ ai_gen_id }}">
            {{ block.settings.card_description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Take a closer look",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "inline_richtext",
      "id": "section_heading",
      "label": "Section heading",
      "default": "TAKE A CLOSER LOOK"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "range",
      "id": "section_spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "section_spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap below heading",
      "min": 16,
      "max": 80,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image (optional)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Instant tint control demonstration"
    },
    {
      "type": "select",
      "id": "image_focal_point",
      "label": "Image focal point",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "top center",
          "label": "Top"
        },
        {
          "value": "bottom center",
          "label": "Bottom"
        },
        {
          "value": "center left",
          "label": "Left"
        },
        {
          "value": "center right",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "min": 40,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 75,
      "info": "Lower values create wider images"
    },
    {
      "type": "inline_richtext",
      "id": "card_heading",
      "label": "Heading",
      "default": "INSTANT TINT CONTROL"
    },
    {
      "type": "richtext",
      "id": "card_description",
      "label": "Description",
      "default": "<p>Adjust your window from deep privacy to open clarity using the remote.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f5f5f0"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#3a3a3a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (links)",
      "default": "#00D4FF"
    }
  ],
  "presets": [
    {
      "name": "Take a closer look"
    }
  ]
}
{% endschema %}
