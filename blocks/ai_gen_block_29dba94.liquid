    {
      "type": "range",
      "id": "mobile_section_height",
      "min": 300,
      "max": 700,
      "step": 50,
      "unit": "px",
      "label": "Mobile height",
      "default": 500
    },
    {
      "type": "header",
      "content": "Text box"
    },
    {
      "type": "color",
      "id": "text_box_bg_color",
      "label": "Background color",
      "default": "#6EA4FF"
