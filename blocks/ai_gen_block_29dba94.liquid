      "default": "<p>Let's be honest — no one's ever said, 'I love taking out the trash.'</p><p>But we thought… 🤔</p><p>what if you kind of could?</p>"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "paragraph_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Paragraph size",
      "default": 16
    },
    {
      "type": "header",
