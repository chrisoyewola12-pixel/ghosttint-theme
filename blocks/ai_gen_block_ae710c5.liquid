{% doc %}
  @prompt
    Generate a premium responsive Shopify installation section for Ghost Tints.
    
    Use a black background and a wide editable installation-bay image. Create an editorial split layout with the copy on one side and the image on the other.
    
    Default content:
    Heading: “INSTALLATION CONFIDENCE.”
    Description: “Professional installation. Vehicle-specific fitment. Guidance every step of the way.”
    Button: “Explore Installation”
    
    Make the heading use a large condensed font with warm-white body text and a cyan button. Add editable controls for desktop and mobile images, focal points, overlay, button destination, text position, alignment, section height and spacing.
    
    The image should focus on a professionally installed finished vehicle. Do not display loose wiring, controller boxes, fuse taps, tools or exposed internal components. Do not make guarantees about universal compatibility or installation availability. Stack the layout cleanly on mobile and preserve readable contrast.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-installation-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-installation-container-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    min-height: {{ block.settings.section_height }}px;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-installation-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.text_vertical_position }};
    align-items: {{ block.settings.text_horizontal_alignment }};
    padding: {{ block.settings.content_padding_desktop }}px;
    text-align: {{ block.settings.text_alignment }};
    z-index: 2;
    position: relative;
  }

  .ai-installation-image-wrapper-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .ai-installation-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.desktop_image_focal_x }}% {{ block.settings.desktop_image_focal_y }}%;
    display: block;
  }

  .ai-installation-image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.image_overlay_color }};
    opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-installation-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .ai-installation-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size_desktop }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px 0;
    line-height: 1.6;
    max-width: 500px;
  }

  .ai-installation-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-installation-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-installation-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-installation-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-installation-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    background-color: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    font-size: 14px;
    border-radius: 4px;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .ai-installation-container-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
      min-height: auto;
    }

    .ai-installation-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_mobile }}px;
      align-items: {{ block.settings.mobile_text_alignment }};
      text-align: {{ block.settings.mobile_text_align }};
    }

    .ai-installation-image-wrapper-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-installation-image-{{ ai_gen_id }} {
      object-position: {{ block.settings.mobile_image_focal_x }}% {{ block.settings.mobile_image_focal_y }}%;
    }

    .ai-installation-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-installation-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
      max-width: 100%;
    }

    .ai-installation-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_text_size_mobile }}px;
    }
  }
{% endstyle %}

<installation-section-{{ ai_gen_id }}
  class="ai-installation-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-installation-container-{{ ai_gen_id }}">
    {% if block.settings.layout_order == 'content_first' %}
      <div class="ai-installation-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-installation-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-installation-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a
            href="{{ block.settings.button_link }}"
            class="ai-installation-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-installation-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.desktop_image %}
        <picture>
          {% if block.settings.mobile_image %}
            <source
              media="(max-width: 989px)"
              srcset="{{ block.settings.mobile_image | image_url: width: 1000 }}"
            >
          {% endif %}
          <img
            src="{{ block.settings.desktop_image | image_url: width: 2000 }}"
            alt="{{ block.settings.desktop_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.desktop_image.width }}"
            height="{{ block.settings.desktop_image.height }}"
            class="ai-installation-image-{{ ai_gen_id }}"
          >
        </picture>
      {% else %}
        <div class="ai-installation-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-installation-empty-state-{{ ai_gen_id }}">
            Add an installation bay image
          </div>
        </div>
      {% endif %}
      <div class="ai-installation-image-overlay-{{ ai_gen_id }}"></div>
    </div>

    {% if block.settings.layout_order == 'image_first' %}
      <div class="ai-installation-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-installation-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-installation-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}

        {% if block.settings.button_text != blank %}
          <a
            href="{{ block.settings.button_link }}"
            class="ai-installation-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</installation-section-{{ ai_gen_id }}>

