    {
      "type": "range",
      "id": "mobile_row_spacing",
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Row spacing",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 40
