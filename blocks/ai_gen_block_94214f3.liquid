{% doc %}
  @prompt
    Create a clean minimal feature-icons section on a pure white background (#FFFFFF) with a centered layout. Display a 2-column grid containing 6 items total (3 rows x 2 columns). Each item should feature a simple outline-style icon in navy (#002B5B) to the left of its text label, vertically centered with the text. All text should be medium weight, dark navy (#002B5B), using a modern sans-serif font. Use equal spacing between rows and columns and align all icons and text perfectly for a premium, minimalist feel. Use the exact feature labels in this order: Left column — “Touch-Free Lid Open”, “Auto Reloading Bags”, “Easy Bag Ring Replacement”; Right column — “Self-Sealing Tech”, “Odor Lock Protection”, “Continuously improved”. Do not add borders, backgrounds, shadows, or dividers — only clean icon + text combinations on white with generous padding above and below the entire section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-icons-{{ ai_gen_id }} {
    background-color: #FFFFFF;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
  }

  .ai-feature-icons-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-feature-icons-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.row_spacing }}px {{ block.settings.column_spacing }}px;
  }

  .ai-feature-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: #002B5B;
  }

  .ai-feature-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-feature-label-{{ ai_gen_id }} {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: {{ block.settings.text_size }}px;
    font-weight: 500;
    color: #002B5B;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-icons-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_row_spacing }}px;
    }

    .ai-feature-icons-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px 20px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-feature-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-feature-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }
  }
{% endstyle %}

<div class="ai-feature-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-icons-container-{{ ai_gen_id }}">
    <div class="ai-feature-icons-grid-{{ ai_gen_id }}">
      <div class="ai-feature-item-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="6" width="18" height="13" rx="2" ry="2"></rect>
            <path d="M12 6V3"></path>
            <path d="M8 3h8"></path>
            <path d="M7 10h10"></path>
          </svg>
        </div>
        <span class="ai-feature-label-{{ ai_gen_id }}">Touch-Free Lid Open</span>
      </div>

      <div class="ai-feature-item-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </div>
        <span class="ai-feature-label-{{ ai_gen_id }}">Self-Sealing Tech</span>
      </div>

      <div class="ai-feature-item-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="7.5 4.21 12 6.81 16.5 4.21"></polyline>
            <polyline points="7.5 19.79 7.5 14.6 3 12"></polyline>
            <polyline points="21 12 16.5 14.6 16.5 19.79"></polyline>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <span class="ai-feature-label-{{ ai_gen_id }}">Auto Reloading Bags</span>
      </div>

      <div class="ai-feature-item-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
        </div>
        <span class="ai-feature-label-{{ ai_gen_id }}">Odor Lock Protection</span>
      </div>

      <div class="ai-feature-item-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 1v6m0 6v6"></path>
            <path d="M17 7l-5 5"></path>
            <path d="M7 7l5 5m5 0l5 5m-10 0l-5 5"></path>
          </svg>
        </div>
        <span class="ai-feature-label-{{ ai_gen_id }}">Easy Bag Ring Replacement</span>
      </div>

      <div class="ai-feature-item-{{ ai_gen_id }}">
        <div class="ai-feature-icon-{{ ai_gen_id }}">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            <polyline points="17 6 23 6 23 12"></polyline>
          </svg>
        </div>
        <span class="ai-feature-label-{{ ai_gen_id }}">Continuously improved</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature icons",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Container width",
      "default": 1000
    },
    {
      "type": "range",
      "id": "row_spacing",
