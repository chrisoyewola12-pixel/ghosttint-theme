      "default": "center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "FROM PRIVATE TO OPEN. YOU DECIDE."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>From deep privacy to open clarity. You decide.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Explore the Technology"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Image labels"
    },
