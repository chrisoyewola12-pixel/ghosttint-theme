{% doc %}
  @prompt
    Create a full-width “Our Promise” trust-badge section with a solid navy background color #002B5B. Add a thin horizontal divider line at the top spanning about 80% of the section width in white with 40% opacity. Below the line, build a 5-column horizontal grid aligned center across the page. The first column is a text block: small uppercase white label “OUR PROMISE” with increased letter-spacing, followed by a short paragraph in white reading “We hope you love it. And if you don’t? Tell us. We’re always listening.” using a slightly smaller font size and relaxed line-height. The remaining four columns are simple stacked icon badges, each vertically centered with white outline icons above bold all-caps text labels beneath them. Use minimal line-style icons in white and evenly spaced between badges. Use these exact labels left-to-right: “WE SHIP FAST. WITHIN 5 DAYS.”, “WE STAND BY OUR QUALITY.”, “WE’LL NEVER STOP IMPROVING.”, “24/7 CUSTOMER SUPPORT”. Keep spacing clean and consistent, icons sized slightly larger than the text below, no boxes, no borders, no shadows, modern premium style exactly matching the screenshot layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-section-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-trust-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}%;
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    opacity: {{ block.settings.divider_opacity | divided_by: 100.0 }};
    margin: 0 auto {{ block.settings.divider_spacing }}px;
  }

  .ai-trust-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-trust-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-trust-text-block-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-trust-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.text_color }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.label_letter_spacing }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.label_spacing }}px;
  }

  .ai-trust-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
  }

  .ai-trust-badge-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: {{ block.settings.badge_icon_spacing }}px;
  }

  .ai-trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-trust-badge-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.badge_font_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.badge_letter_spacing }}px;
    line-height: {{ block.settings.badge_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-trust-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-trust-text-block-{{ ai_gen_id }} {
      grid-column: 1 / -1;
      text-align: center;
      margin-bottom: {{ block.settings.mobile_text_spacing }}px;
    }

    .ai-trust-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-trust-badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_badge_font_size }}px;
    }

    .ai-trust-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_label_font_size }}px;
    }

    .ai-trust-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_font_size }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-trust-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="ai-trust-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-divider-{{ ai_gen_id }}"></div>
  
  <div class="ai-trust-container-{{ ai_gen_id }}">
    <div class="ai-trust-grid-{{ ai_gen_id }}">
      <div class="ai-trust-text-block-{{ ai_gen_id }}">
        <p class="ai-trust-label-{{ ai_gen_id }}">{{ block.settings.label_text }}</p>
        <p class="ai-trust-description-{{ ai_gen_id }}">{{ block.settings.description_text }}</p>
      </div>

      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <svg class="ai-trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_1_text }}</p>
      </div>

      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <svg class="ai-trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_2_text }}</p>
      </div>

      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <svg class="ai-trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        </svg>
        <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_3_text }}</p>
      </div>

      <div class="ai-trust-badge-{{ ai_gen_id }}">
        <svg class="ai-trust-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <p class="ai-trust-badge-text-{{ ai_gen_id }}">{{ block.settings.badge_4_text }}</p>
      </div>
    </div>
  </div>
</div>

