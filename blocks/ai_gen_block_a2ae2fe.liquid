{% doc %}
  @prompt
    Clean, modern Shopify collection section with a black-and-white minimalist theme. Display compact product cards at a reduced size with rounded corners, evenly spaced in a two-column grid. Each product card shows a main product image by default, and smoothly transitions to a second image on hover (image swap hover effect) showing the product in use. Include bold product titles beneath each image, a star rating row, and price in EUR. Overall layout should feel sleek, automotive-focused, and premium, with subtle hover animations, clear hierarchy, and optimized spacing for a smaller, more compact collection display., Add a visible “Quick Add” or “Add to Cart” button on each product card. When clicked, the product is instantly added to cart and the user is immediately redirected to the cart page. Button should appear on hover or beneath the product image, with a clean toggle-style behavior similar to Shopify’s “Enable quick add button,” maintaining a minimal, fast, and conversion-focused user experience.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-collection-grid__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 40px;
    color: {{ block.settings.heading_color }};
    font-size: 32px;
    font-weight: bold;
  }

  .ai-collection-grid__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-collection-grid__card-{{ ai_gen_id }} {
    position: relative;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    display: block;
    text-decoration: none;
  }

  .ai-collection-grid__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
  }

  .ai-collection-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-collection-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease;
  }

  .ai-collection-grid__image-primary-{{ ai_gen_id }} {
    opacity: 1;
    z-index: 2;
  }

  .ai-collection-grid__image-secondary-{{ ai_gen_id }} {
    opacity: 0;
    z-index: 1;
  }

  .ai-collection-grid__card-{{ ai_gen_id }}:hover .ai-collection-grid__image-primary-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-collection-grid__card-{{ ai_gen_id }}:hover .ai-collection-grid__image-secondary-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-collection-grid__quick-add-wrapper-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    z-index: 10;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }

  .ai-collection-grid__card-{{ ai_gen_id }}:hover .ai-collection-grid__quick-add-wrapper-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .ai-collection-grid__quick-add-btn-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-collection-grid__quick-add-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: scale(1.02);
  }

  .ai-collection-grid__quick-add-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ai-collection-grid__info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
  }

  .ai-collection-grid__title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    font-size: {{ block.settings.title_size }}px;
    font-weight: bold;
    color: {{ block.settings.title_color }};
    line-height: 1.3;
  }

  .ai-collection-grid__rating-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2px;
    margin-bottom: 8px;
  }

  .ai-collection-grid__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-collection-grid__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    font-weight: 600;
    color: {{ block.settings.price_color }};
  }

  .ai-collection-grid__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid__container-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-collection-grid__heading-{{ ai_gen_id }} {
      font-size: 24px;
      margin-bottom: 24px;
    }

    .ai-collection-grid__products-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-collection-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-collection-grid__price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_size | times: 0.9 }}px;
    }

    .ai-collection-grid__quick-add-wrapper-{{ ai_gen_id }} {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .ai-collection-grid__quick-add-btn-{{ ai_gen_id }} {
      padding: 10px 16px;
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }} class="ai-collection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collection-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.collection != blank %}
      <div class="ai-collection-grid__products-{{ ai_gen_id }}">
        {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
          <div class="ai-collection-grid__card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
            <a href="{{ product.url }}" class="ai-collection-grid__link-{{ ai_gen_id }}">
              <div class="ai-collection-grid__image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-collection-grid__image-{{ ai_gen_id }} ai-collection-grid__image-primary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% endif %}

                {% if product.images[1] %}
                  <img
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.images[1].alt | escape }}"
                    class="ai-collection-grid__image-{{ ai_gen_id }} ai-collection-grid__image-secondary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% elsif product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    class="ai-collection-grid__image-{{ ai_gen_id }} ai-collection-grid__image-secondary-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% endif %}

                {% if block.settings.show_quick_add %}
                  <div class="ai-collection-grid__quick-add-wrapper-{{ ai_gen_id }}">
                    <button
                      type="button"
                      class="ai-collection-grid__quick-add-btn-{{ ai_gen_id }}"
                      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      data-product-url="{{ product.url }}"
                      {% unless product.available %}disabled{% endunless %}
                    >
                      {% if product.available %}
                        {{ block.settings.button_text }}
                      {% else %}
                        Sold Out
                      {% endif %}
                    </button>
                  </div>
                {% endif %}
              </div>
            </a>

            <div class="ai-collection-grid__info-{{ ai_gen_id }}">
              <a href="{{ product.url }}" style="text-decoration: none;">
                <h3 class="ai-collection-grid__title-{{ ai_gen_id }}">{{ product.title }}</h3>
              </a>

              {% if block.settings.show_rating %}
                <div class="ai-collection-grid__rating-{{ ai_gen_id }}">
                  {% for i in (1..5) %}
                    <svg class="ai-collection-grid__star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% endfor %}
                </div>
              {% endif %}

              <div class="ai-collection-grid__price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-collection-grid__empty-{{ ai_gen_id }}">
        <p>Select a collection to display products</p>
      </div>
    {% endif %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-collection-grid__card-{{ ai_gen_id }}');
        this.setupImageSwap();
        this.setupQuickAdd();
      }

      setupImageSwap() {
        this.cards.forEach((card) => {
          const primaryImage = card.querySelector('.ai-collection-grid__image-primary-{{ ai_gen_id }}');
          const secondaryImage = card.querySelector('.ai-collection-grid__image-secondary-{{ ai_gen_id }}');

          if (primaryImage && secondaryImage) {
            card.addEventListener('mouseenter', () => {
              primaryImage.style.opacity = '0';
              secondaryImage.style.opacity = '1';
            });

            card.addEventListener('mouseleave', () => {
              primaryImage.style.opacity = '1';
              secondaryImage.style.opacity = '0';
            });
          }
        });
      }

      setupQuickAdd() {
        const quickAddButtons = this.querySelectorAll('.ai-collection-grid__quick-add-btn-{{ ai_gen_id }}');

        quickAddButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const variantId = button.getAttribute('data-variant-id');
            const productUrl = button.getAttribute('data-product-url');

            if (!variantId || button.disabled) {
              return;
            }

            button.disabled = true;
            const originalText = button.textContent;
            button.textContent = 'Adding...';

            this.addToCart(variantId)
              .then(() => {
                button.textContent = 'Added!';
                setTimeout(() => {
                  window.location.href = '/cart';
                }, 300);
              })
              .catch((error) => {
                console.error('Error adding to cart:', error);
                button.textContent = 'Error';
                button.disabled = false;
                setTimeout(() => {
                  button.textContent = originalText;
                }, 2000);
              });
          });
        });
      }

      addToCart(variantId) {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        })
        .then(response => {
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          return response.json();
        });
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

