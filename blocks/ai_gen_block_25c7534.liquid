{% doc %}
  @prompt
    Create a clean step-by-step “How It Works” section on a pure white background (#FFFFFF). At the top left add a bold navy headline (#002B5B) reading “Here’s how the Royal Bin™ works”. Below it create a single horizontal row of four equal-width vertical cards with consistent spacing. Each card must support merchant-uploaded images via Shopify file picker (no static images or placeholders generated by the theme). Images should fill the top of each card with rounded corners (14–16px radius). Beneath each image add centered dark gray (#444444) caption text exactly as follows, one line per card: Card1: “Press and hold button for 3 seconds”; Card2: “It self-seals within seconds”; Card3: “Take the bag out, and…”; Card4: “It auto-reloads a new bag”. Remove all shadows and borders, keep layout fully minimal and premium, ensure equal card heights and responsive stacking into two rows on mobile while maintaining spacing and alignment.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-how-it-works-{{ ai_gen_id }} {
    background-color: #FFFFFF;
    padding: 60px 20px;
  }

  .ai-how-it-works-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-how-it-works-headline-{{ ai_gen_id }} {
    color: #002B5B;
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 40px 0;
    text-align: left;
  }

  .ai-how-it-works-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .ai-how-it-works-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
  }

  .ai-how-it-works-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 15px;
    margin-bottom: 16px;
  }

  .ai-how-it-works-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-how-it-works-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-how-it-works-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-how-it-works-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    color: #999;
    text-align: center;
    white-space: nowrap;
  }

  .ai-how-it-works-caption-{{ ai_gen_id }} {
    color: #444444;
    font-size: 15px;
    line-height: 1.5;
    text-align: center;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-how-it-works-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-how-it-works-headline-{{ ai_gen_id }} {
      font-size: 28px;
      margin-bottom: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-how-it-works-{{ ai_gen_id }} {
      padding: 40px 16px;
    }

    .ai-how-it-works-headline-{{ ai_gen_id }} {
      font-size: 24px;
      margin-bottom: 24px;
    }

    .ai-how-it-works-grid-{{ ai_gen_id }} {
      gap: 16px;
    }

    .ai-how-it-works-caption-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-how-it-works-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-how-it-works-container-{{ ai_gen_id }}">
    <h2 class="ai-how-it-works-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
    
    <div class="ai-how-it-works-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'step_' | append: i | append: '_image'
          assign caption_key = 'step_' | append: i | append: '_caption'
          assign step_image = block.settings[image_key]
          assign step_caption = block.settings[caption_key]
        %}
        
        <div class="ai-how-it-works-card-{{ ai_gen_id }}">
          <div class="ai-how-it-works-image-wrapper-{{ ai_gen_id }}">
            {% if step_image %}
              <img
                src="{{ step_image | image_url: width: 600 }}"
                alt="{{ step_caption | escape }}"
                loading="lazy"
                width="600"
                height="600"
                class="ai-how-it-works-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-how-it-works-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-how-it-works-empty-state-{{ ai_gen_id }}">
                  Add image
                </div>
              </div>
            {% endif %}
          </div>
          
          <p class="ai-how-it-works-caption-{{ ai_gen_id }}">{{ step_caption }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
