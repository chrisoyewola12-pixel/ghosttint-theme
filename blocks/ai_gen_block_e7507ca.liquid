{% doc %}
  @prompt
    Create a responsive testimonial gallery section with a pure white background (#FFFFFF). At the top center add the headline “OVER 10K HAPPY CUSTOMERS” in bold navy (#002B5B). Under it place a small rating row with 5 orange stars (#FFA500) followed by the text “4.9 • 400+” in dark gray (#555555). Add generous vertical spacing between the heading, star row, and gallery.
    
    Desktop layout: Display 3 image testimonial cards in a 3-column grid with equal width and spacing. Each card uses an image upload block so the merchant can upload photos directly. Images appear on top inside rounded corners. Below each image add the testimonial title in bold navy (#002B5B), then a paragraph testimonial in medium gray (#555555) with line-height 1.6–1.8 and 8–12px vertical spacing between text elements. Add the reviewer name below styled with “— Name”. At the bottom include a small “VERIFIED REVIEW” badge with icon in blue (#0066FF). Cards should have internal padding (18–24px) but no borders or shadows—clean and minimal look.
    
    Mobile layout: Convert cards into a horizontal swipe carousel using scroll-snap behavior. Show one centered card (~85–90% width) with a partial preview of the next card. Keep the headline and star row centered above the carousel. Maintain generous line spacing for readability and consistent vertical gaps between elements.
    
    Images must keep their original aspect ratio with no forced cropping or overlays. The entire section should feel bright, spacious, modern, and highly readable on both desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-gallery-{{ ai_gen_id }} {
    background-color: #FFFFFF;
    padding: 60px 20px;
  }

  .ai-testimonial-gallery-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-testimonial-gallery-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-testimonial-gallery-headline-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    color: #002B5B;
    margin: 0 0 16px 0;
    letter-spacing: 0.5px;
  }

  .ai-testimonial-gallery-rating-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
  }

  .ai-testimonial-gallery-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-testimonial-gallery-star-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    fill: #FFA500;
  }

  .ai-testimonial-gallery-rating-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: #555555;
    font-weight: 500;
  }

  .ai-testimonial-gallery-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: #FFFFFF;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .ai-testimonial-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: 20px;
    border-radius: 12px;
    overflow: hidden;
  }

  .ai-testimonial-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-testimonial-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: #002B5B;
    margin: 0 0 10px 0;
    line-height: 1.4;
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-size: 15px;
    color: #555555;
    line-height: 1.7;
    margin: 0 0 12px 0;
    flex-grow: 1;
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    font-size: 14px;
    color: #555555;
    margin: 0 0 12px 0;
    font-style: italic;
  }

  .ai-testimonial-verified-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #0066FF;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .ai-testimonial-verified-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: #0066FF;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonial-gallery-{{ ai_gen_id }} {
      padding: 50px 0;
    }

    .ai-testimonial-gallery-headline-{{ ai_gen_id }} {
      font-size: 28px;
      padding: 0 20px;
    }

    .ai-testimonial-gallery-rating-row-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-testimonial-gallery-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding: 0 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ai-testimonial-gallery-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      flex: 0 0 87%;
      scroll-snap-align: center;
      max-width: 400px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-gallery-headline-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-testimonial-gallery-rating-text-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-testimonial-title-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-testimonial-text-{{ ai_gen_id }} {
      font-size: 14px;
      line-height: 1.6;
    }
  }
{% endstyle %}

<div class="ai-testimonial-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-gallery-container-{{ ai_gen_id }}">
    <div class="ai-testimonial-gallery-header-{{ ai_gen_id }}">
      <h2 class="ai-testimonial-gallery-headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h2>
      
      <div class="ai-testimonial-gallery-rating-row-{{ ai_gen_id }}">
        <div class="ai-testimonial-gallery-stars-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            <svg class="ai-testimonial-gallery-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          {% endfor %}
        </div>
        <span class="ai-testimonial-gallery-rating-text-{{ ai_gen_id }}">
          {{ block.settings.rating_text }}
        </span>
      </div>
    </div>

    <div class="ai-testimonial-gallery-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'testimonial_' | append: i | append: '_image'
          assign title_key = 'testimonial_' | append: i | append: '_title'
          assign text_key = 'testimonial_' | append: i | append: '_text'
          assign author_key = 'testimonial_' | append: i | append: '_author'
          
          assign testimonial_image = block.settings[image_key]
          assign testimonial_title = block.settings[title_key]
          assign testimonial_text = block.settings[text_key]
          assign testimonial_author = block.settings[author_key]
        %}
        
        <div class="ai-testimonial-card-{{ ai_gen_id }}">
          <div class="ai-testimonial-image-wrapper-{{ ai_gen_id }}">
            {% if testimonial_image %}
              <img
                src="{{ testimonial_image | image_url: width: 600 }}"
                alt="{{ testimonial_title | escape }}"
                class="ai-testimonial-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ testimonial_image.width }}"
                height="{{ testimonial_image.height }}"
              >
            {% else %}
              <div class="ai-testimonial-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if testimonial_title != blank %}
            <h3 class="ai-testimonial-title-{{ ai_gen_id }}">
              {{ testimonial_title }}
            </h3>
          {% endif %}

          {% if testimonial_text != blank %}
            <p class="ai-testimonial-text-{{ ai_gen_id }}">
              {{ testimonial_text }}
            </p>
          {% endif %}

          {% if testimonial_author != blank %}
            <p class="ai-testimonial-author-{{ ai_gen_id }}">
              — {{ testimonial_author }}
            </p>
          {% endif %}

          <div class="ai-testimonial-verified-{{ ai_gen_id }}">
            <svg class="ai-testimonial-verified-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
            </svg>
            <span>VERIFIED REVIEW</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

