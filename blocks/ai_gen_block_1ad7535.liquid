{% doc %}
  @prompt
    Create a compact Ghost Tints benefits section that displays all three benefits (Instant Privacy, SPF protection, and a third benefit) in a single row on mobile without scrolling. The section should have a dark background, small icons above each benefit title, minimal padding and spacing, and fit entirely within a mobile screen viewport. The design should match a sleek, dark automotive tint brand aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
    align-items: start;
  }

  .ai-benefit-item-{{ ai_gen_id }} {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ block.settings.item_gap }}px;
  }

  .ai-benefit-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-benefit-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-benefit-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    line-height: 1.2;
    margin: 0;
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: 0.5px;
  }

  .ai-benefit-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.4;
    margin: 0;
    opacity: {{ block.settings.description_opacity }};
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding }}px 0;
    }

    .ai-benefits-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-benefits-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-benefit-item-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_item_gap }}px;
    }

    .ai-benefit-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-benefit-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-benefit-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_size }}px;
    }
  }
{% endstyle %}

<div class="ai-benefits-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
