{% schema %}
{
  "name": "Ghost Tints benefits",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1200
