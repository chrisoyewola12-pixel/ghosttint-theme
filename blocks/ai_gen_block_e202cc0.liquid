{% doc %}
  @prompt
    Generate a responsive Shopify section titled “TAKE A CLOSER LOOK.”
    
    This section will be placed immediately after the existing Product Information section. Do not create a product form, variant selector, price, quantity control, Add to Cart button, Buy It Now button, upsell or free-gift logic.
    
    Create two large editable animated-WebP cards:
    
    1. Heading: “INSTANT TINT CONTROL”
       Copy: “Adjust your window from deep privacy to open clarity using the remote.”
    2. Heading: “GHOST TINTS IN ACTION”
       Copy: “See the SPD glass change while maintaining a clean, integrated finish.”
    
    Each card must support:
    
    * Animated WebP image picker
    * Separate optional mobile image
    * Heading
    * Description
    * Alt text
    * Image focal point
    
    Display the cards side by side on desktop and vertically on mobile. Use an obsidian-black background, warm-white text, thin graphite borders and restrained cyan accents. Do not add play icons, video controls, progress bars or hover overlays. Preserve WebP animation naturally.
    
    Add settings for image ratio, card gap, content width, section spacing and background color. Use responsive Shopify image rendering and lazy-load the assets.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-closer-look-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_spacing_top }}px 0 {{ block.settings.section_spacing_bottom }}px;
  }

  .ai-closer-look-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-closer-look-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: 32px;
    letter-spacing: 2px;
  }

  .ai-closer-look-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-closer-look-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-closer-look-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-closer-look-image-wrapper-{{ ai_gen_id }}::before {
    content: '';
    display: block;
    padding-bottom: {{ block.settings.image_ratio }}%;
  }

  .ai-closer-look-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_focal_point }};
  }

  .ai-closer-look-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-closer-look-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-closer-look-content-{{ ai_gen_id }} {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-closer-look-card-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    font-size: 20px;
    letter-spacing: 1.5px;
    line-height: 1.3;
  }

  .ai-closer-look-card-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .ai-closer-look-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.7 }}px;
    }

    .ai-closer-look-heading-{{ ai_gen_id }} {
      font-size: 24px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.7 }}px;
    }

    .ai-closer-look-content-{{ ai_gen_id }} {
      padding: 24px 20px;
    }

    .ai-closer-look-card-heading-{{ ai_gen_id }} {
      font-size: 18px;
    }

    .ai-closer-look-card-description-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-closer-look-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-closer-look-container-{{ ai_gen_id }}">
    <h2 class="ai-closer-look-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    
    <div class="ai-closer-look-grid-{{ ai_gen_id }}">
      <div class="ai-closer-look-card-{{ ai_gen_id }}">
        <div class="ai-closer-look-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.card_1_image_mobile and block.settings.card_1_image %}
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="{{ block.settings.card_1_image_mobile | image_url: width: 800 }}"
              >
              <img
                src="{{ block.settings.card_1_image | image_url: width: 1200 }}"
                alt="{{ block.settings.card_1_alt_text | escape }}"
                loading="lazy"
                width="{{ block.settings.card_1_image.width }}"
                height="{{ block.settings.card_1_image.height }}"
                class="ai-closer-look-image-{{ ai_gen_id }}"
              >
            </picture>
          {% elsif block.settings.card_1_image %}
            <img
              src="{{ block.settings.card_1_image | image_url: width: 1200 }}"
              alt="{{ block.settings.card_1_alt_text | escape }}"
              loading="lazy"
              width="{{ block.settings.card_1_image.width }}"
              height="{{ block.settings.card_1_image.height }}"
              class="ai-closer-look-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-closer-look-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-closer-look-content-{{ ai_gen_id }}">
          <h3 class="ai-closer-look-card-heading-{{ ai_gen_id }}">{{ block.settings.card_1_heading }}</h3>
          <p class="ai-closer-look-card-description-{{ ai_gen_id }}">{{ block.settings.card_1_description }}</p>
        </div>
      </div>

      <div class="ai-closer-look-card-{{ ai_gen_id }}">
        <div class="ai-closer-look-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.card_2_image_mobile and block.settings.card_2_image %}
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="{{ block.settings.card_2_image_mobile | image_url: width: 800 }}"
              >
              <img
                src="{{ block.settings.card_2_image | image_url: width: 1200 }}"
                alt="{{ block.settings.card_2_alt_text | escape }}"
                loading="lazy"
                width="{{ block.settings.card_2_image.width }}"
                height="{{ block.settings.card_2_image.height }}"
                class="ai-closer-look-image-{{ ai_gen_id }}"
              >
            </picture>
          {% elsif block.settings.card_2_image %}
            <img
              src="{{ block.settings.card_2_image | image_url: width: 1200 }}"
              alt="{{ block.settings.card_2_alt_text | escape }}"
              loading="lazy"
              width="{{ block.settings.card_2_image.width }}"
              height="{{ block.settings.card_2_image.height }}"
              class="ai-closer-look-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-closer-look-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        <div class="ai-closer-look-content-{{ ai_gen_id }}">
          <h3 class="ai-closer-look-card-heading-{{ ai_gen_id }}">{{ block.settings.card_2_heading }}</h3>
          <p class="ai-closer-look-card-description-{{ ai_gen_id }}">{{ block.settings.card_2_description }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

