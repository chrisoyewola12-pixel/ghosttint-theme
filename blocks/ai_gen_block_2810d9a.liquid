                  </svg>
                {% endif %}
              </div>
              <div class="ai-image-steps-step-content-{{ ai_gen_id }}">
                <h3 class="ai-image-steps-step-title-{{ ai_gen_id }}">{{ block.settings.step_2_title }}</h3>
                {% if block.settings.step_2_description != blank %}
                  <p class="ai-image-steps-step-description-{{ ai_gen_id }}">{{ block.settings.step_2_description }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}

          {% if block.settings.step_3_title != blank %}
            <div class="ai-image-steps-step-{{ ai_gen_id }}">
              <div class="ai-image-steps-step-icon-{{ ai_gen_id }}">
                {% if block.settings.step_3_icon == 'check' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
