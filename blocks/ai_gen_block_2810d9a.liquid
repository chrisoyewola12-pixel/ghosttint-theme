{% doc %}
  @prompt
    Generate a responsive Shopify image-with-steps section for Ghost Tints. Use a warm off-white background to contrast with the surrounding black sections.
    
    Create a two-column desktop layout:
    
    * Large editable installed-window image on the left
    * Heading, description and three process blocks on the right
    
    Default heading:
    “DESIGNED FOR YOUR DRIVE.”
    
    Create three editable step blocks with minimal line icons:
    
    1. “Choose Your Vehicle”
    2. “Install Ghost Tints”
    3. “Control Your Privacy”
    
    Use dark charcoal text, restrained cyan accents and a bold condensed heading. Add controls for image position, image ratio, focal point, background color, text alignment, icons, spacing and content width.
    
    On mobile, place the image first and stack the three steps beneath the copy. Keep the design minimal and customer-facing. Do not show wiring, controllers, fuse taps, loose film, installation tools, reviews or technical claims.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-steps-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-image-steps-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-steps-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.grid_gap }}px;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .ai-image-steps-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      gap: {{ block.settings.grid_gap_desktop }}px;
    }
  }

  .ai-image-steps-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-steps-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    object-position: {{ block.settings.image_focal_point }};
  }

  .ai-image-steps-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-steps-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-image-steps-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-steps-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-image-steps-text-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-image-steps-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .ai-image-steps-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size }}px;
    }
  }

  .ai-image-steps-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-image-steps-steps-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.steps_gap }}px;
  }

  .ai-image-steps-step-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.step_icon_gap }}px;
    text-align: left;
  }

  .ai-image-steps-step-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-image-steps-step-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-image-steps-step-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-image-steps-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px;
    line-height: 1.4;
  }

  .ai-image-steps-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    {% if block.settings.mobile_image_position == 'top' %}
      .ai-image-steps-grid-{{ ai_gen_id }} .ai-image-steps-image-wrapper-{{ ai_gen_id }},
      .ai-image-steps-grid-{{ ai_gen_id }} .ai-image-steps-image-placeholder-{{ ai_gen_id }} {
        order: -1;
      }
    {% endif %}
  }
{% endstyle %}

<image-with-steps-{{ ai_gen_id }} class="ai-image-steps-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
