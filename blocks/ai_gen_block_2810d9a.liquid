</image-with-steps-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageWithSteps{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('image-with-steps-{{ ai_gen_id }}', ImageWithSteps{{ ai_gen_id }});
  })();
</script>

