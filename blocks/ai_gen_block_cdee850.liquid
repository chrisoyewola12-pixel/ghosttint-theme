                src="{{ block.settings.feature_2_image | image_url: width: 1200 }}"
                alt="{{ block.settings.feature_2_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.feature_2_image.width }}"
                height="{{ block.settings.feature_2_image.height }}"
              >
            </div>
          {% else %}
            <div class="ai-feature-media-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-feature-empty-state-{{ ai_gen_id }}">
                Add an image or video
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.feature_3_enabled %}
      <div class="ai-feature-block-{{ ai_gen_id }}">
        <div class="ai-feature-content-{{ ai_gen_id }}">
          {% if block.settings.feature_3_headline != blank %}
            <h2 class="ai-feature-headline-{{ ai_gen_id }}">{{ block.settings.feature_3_headline }}</h2>
          {% endif %}
          {% if block.settings.feature_3_text != blank %}
            <div class="ai-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</div>
          {% endif %}
        </div>
        <div>
          {% if block.settings.feature_3_video != blank %}
            <div class="ai-feature-media-card-{{ ai_gen_id }}">
              {{ block.settings.feature_3_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
            </div>
          {% elsif block.settings.feature_3_image != blank %}
            <div class="ai-feature-media-card-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.feature_3_image | image_url: width: 1200 }}"
                alt="{{ block.settings.feature_3_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.feature_3_image.width }}"
                height="{{ block.settings.feature_3_image.height }}"
              >
            </div>
          {% else %}
            <div class="ai-feature-media-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-feature-empty-state-{{ ai_gen_id }}">
                Add an image or video
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.feature_4_enabled %}
      <div class="ai-feature-block-{{ ai_gen_id }} ai-reverse-{{ ai_gen_id }}">
        <div class="ai-feature-content-{{ ai_gen_id }}">
          {% if block.settings.feature_4_headline != blank %}
            <h2 class="ai-feature-headline-{{ ai_gen_id }}">{{ block.settings.feature_4_headline }}</h2>
          {% endif %}
          {% if block.settings.feature_4_text != blank %}
            <div class="ai-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_4_text }}</div>
          {% endif %}
        </div>
        <div>
          {% if block.settings.feature_4_video != blank %}
            <div class="ai-feature-media-card-{{ ai_gen_id }}">
              {{ block.settings.feature_4_video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
            </div>
          {% elsif block.settings.feature_4_image != blank %}
            <div class="ai-feature-media-card-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.feature_4_image | image_url: width: 1200 }}"
                alt="{{ block.settings.feature_4_image.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.feature_4_image.width }}"
                height="{{ block.settings.feature_4_image.height }}"
              >
            </div>
          {% else %}
            <div class="ai-feature-media-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-feature-empty-state-{{ ai_gen_id }}">
                Add an image or video
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

