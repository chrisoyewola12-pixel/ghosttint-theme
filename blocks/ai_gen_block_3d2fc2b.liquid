{% doc %}   @prompt
    Create a customer review section similar to this layout:
        Display star rating summary at the top (★★★★★ + total review count).
        Include a “Write a review” button beside the rating.
        Show reviews in a responsive Masonry / grid layout (3 columns on desktop, 2 on tablet, 1 on mobile).
        Each review card should contain:
        Customer name (first name + last initial) and Verified badge icon
        5-star rating display
        Review text
        Optional customer uploaded photo displayed above or inside the card
        Small product thumbnail + product name link at the bottom
        Date of review
        Support reviews with media galleries (photos clickable to view larger).
        Allow store replies below reviews with a small “Store replied” label.
        Include sort filters (Newest, Oldest, Highest rating) and pagination or lazy load.
        Match a clean, premium style:
        White card backgrounds
        Soft shadow
        Rounded corners
        Neutral fonts with subtle star icon color
        Mobile-friendly spacing
        Build this as a custom Liquid section that works with Shopify product reviews and supports dynamic review data instead of mock content.

        🔥 Optional Add-On (Highly Recommended)
        Style reference:
        Tight grid spacing
        Card layouts similar to high-end ecommerce review galleries
        Large customer photos inside cards
        Text-first mobile design
        Minimal borders instead of heavy outlines

        💡 Pro Tip for Shrine Theme
        Make sure the section:
        Uses Tailwind or Shrine’s built-in CSS utility classes
        Does not rely on jQuery
        Is compatible with AJAX loading product pages.
        allow for an infinite number of reviews
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 40px;
    padding-bottom: 30px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-reviews-summary-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .ai-reviews-rating-display-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-reviews-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.star_size }}px;
  }

  .ai-reviews-count-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.text_color }};
    font-weight: 500;
  }

  .ai-reviews-write-btn-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
  }

  .ai-reviews-write-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-reviews-filters-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }

  .ai-reviews-filter-btn-{{ ai_gen_id }} {
    padding: 8px 16px;
    background-color: {{ block.settings.filter_bg }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.filter_radius }}px;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-reviews-filter-btn-{{ ai_gen_id }}:hover,
  .ai-reviews-filter-btn-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border-color: {{ block.settings.button_bg_color }};
  }

  .ai-reviews-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: 40px;
  }

  @media screen and (max-width: 989px) {
    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-reviews-header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .ai-review-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.card_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y }}px {{ block.settings.shadow_blur }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-review-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: {{ block.settings.shadow_x }}px {{ block.settings.shadow_y | plus: 4 }}px {{ block.settings.shadow_blur | plus: 10 }}px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 | times: 1.5 }});
  }

  .ai-review-header-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .ai-review-author-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-review-author-name-{{ ai_gen_id }} {
    font-size: 15px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ai-review-verified-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: {{ block.settings.verified_color }};
    background-color: {{ block.settings.verified_bg }};
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 500;
  }

  .ai-review-date-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.secondary_text_color }};
  }

  .ai-review-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 3px;
    color: {{ block.settings.star_color }};
    font-size: 16px;
  }

  .ai-review-image-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_radius }}px;
    overflow: hidden;
    cursor: pointer;
    position: relative;
  }

  .ai-review-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-review-image-{{ ai_gen_id }}:hover img {
    transform: scale(1.05);
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-review-product-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid {{ block.settings.border_color }};
    margin-top: auto;
  }

  .ai-review-product-image-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-review-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-review-product-info-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-review-product-name-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 500;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    display: block;
    transition: color 0.3s ease;
  }

  .ai-review-product-name-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_bg_color }};
  }

  .ai-review-reply-{{ ai_gen_id }} {
    background-color: {{ block.settings.reply_bg }};
    padding: 12px;
    border-radius: 8px;
    border-left: 3px solid {{ block.settings.button_bg_color }};
  }

  .ai-review-reply-label-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 600;
    color: {{ block.settings.button_bg_color }};
    margin-bottom: 6px;
    display: block;
  }

  .ai-review-reply-text-{{ ai_gen_id }} {
    font-size: 13px;
    line-height: 1.5;
    color: {{ block.settings.text_color }};
  }

  .ai-reviews-load-more-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  .ai-reviews-load-more-btn-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-reviews-load-more-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    transform: translateY(-2px);
  }

  .ai-reviews-load-more-btn-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-reviews-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.secondary_text_color }};
  }

  .ai-reviews-empty-{{ ai_gen_id }} h3 {
    font-size: 20px;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-reviews-empty-{{ ai_gen_id }} p {
    font-size: 15px;
    margin-bottom: 24px;
  }

  .ai-review-gallery-modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .ai-review-gallery-modal-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-review-gallery-content-{{ ai_gen_id }} {
    max-width: 90%;
    max-height: 90%;
    position: relative;
  }

  .ai-review-gallery-content-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 90vh;
    border-radius: 8px;
  }

  .ai-review-gallery-close-{{ ai_gen_id }} {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: white;
    font-size: 32px;
    cursor: pointer;
    padding: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-reviews-loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px;
    color: {{ block.settings.secondary_text_color }};
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-reviews-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-header-{{ ai_gen_id }}">
    <div class="ai-reviews-summary-{{ ai_gen_id }}">
      <div class="ai-reviews-rating-display-{{ ai_gen_id }}">
        <div class="ai-reviews-stars-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            <span>★</span>
          {% endfor %}
        </div>
        <span class="ai-reviews-count-{{ ai_gen_id }}" data-review-count>0 reviews</span>
      </div>
    </div>
 {% if block.settings.show_write_button %}
  {% assign write_link = block.settings.write_button_link | default: '/pages/write-a-review' %}
  <a href="{{ write_link }}" class="ai-reviews-write-btn-{{ ai_gen_id }}">
    {{ block.settings.write_button_text }}
  </a>
{% endif %}


  </div>

  {% if block.settings.show_filters %}
    <div class="ai-reviews-filters-{{ ai_gen_id }}">
      <button class="ai-reviews-filter-btn-{{ ai_gen_id }} active" data-filter="newest">
        Newest
      </button>
      <button class="ai-reviews-filter-btn-{{ ai_gen_id }}" data-filter="oldest">
        Oldest
      </button>
      <button class="ai-reviews-filter-btn-{{ ai_gen_id }}" data-filter="highest">
        Highest Rating
      </button>
      <button class="ai-reviews-filter-btn-{{ ai_gen_id }}" data-filter="lowest">
        Lowest Rating
      </button>
    </div>
  {% endif %}

  <div class="ai-reviews-grid-{{ ai_gen_id }}" data-reviews-grid></div>

  <div class="ai-reviews-empty-{{ ai_gen_id }}" style="display: none;" data-empty-state>
    <h3>{{ block.settings.empty_title }}</h3>
    <p>{{ block.settings.empty_message }}</p>
    {% if block.settings.show_write_button %}
      <a href="#write-review" class="ai-reviews-write-btn-{{ ai_gen_id }}">
        Be the first to review
      </a>
    {% endif %}
  </div>

  <div class="ai-reviews-loading-{{ ai_gen_id }}" data-loading>
    Loading reviews...
  </div>

  {% if block.settings.enable_load_more %}
    <div class="ai-reviews-load-more-{{ ai_gen_id }}" style="display: none;" data-load-more-container>
      <button class="ai-reviews-load-more-btn-{{ ai_gen_id }}" data-load-more-btn>
        {{ block.settings.load_more_text }}
      </button>
    </div>
  {% endif %}

  <div class="ai-review-gallery-modal-{{ ai_gen_id }}" data-gallery-modal>
    <div class="ai-review-gallery-content-{{ ai_gen_id }}">
      <button class="ai-review-gallery-close-{{ ai_gen_id }}" data-gallery-close>&times;</button>
      <img src="" alt="Review image" data-gallery-image>
    </div>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.reviews = [];
        this.filteredReviews = [];
        this.currentFilter = 'newest';
        this.reviewsPerPage = {{ block.settings.reviews_per_page }};
        this.currentPage = 1;
        this.grid = this.querySelector('[data-reviews-grid]');
        this.emptyState = this.querySelector('[data-empty-state]');
        this.loadingState = this.querySelector('[data-loading]');
        this.loadMoreContainer = this.querySelector('[data-load-more-container]');
        this.loadMoreBtn = this.querySelector('[data-load-more-btn]');
        this.reviewCount = this.querySelector('[data-review-count]');
        this.galleryModal = this.querySelector('[data-gallery-modal]');
        this.galleryImage = this.querySelector('[data-gallery-image]');
        this.galleryClose = this.querySelector('[data-gallery-close]');
      }

      connectedCallback() {
        this.loadReviews();
        this.setupEventListeners();
      }

      setupEventListeners() {
        const filterBtns = this.querySelectorAll('[data-filter]');
        filterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            this.currentFilter = btn.dataset.filter;
            this.currentPage = 1;
            this.filterAndRenderReviews();
          });
        });

        if (this.loadMoreBtn) {
          this.loadMoreBtn.addEventListener('click', () => {
            this.currentPage++;
            this.renderReviews(true);
          });
        }

        if (this.galleryClose) {
          this.galleryClose.addEventListener('click', () => {
            this.closeGallery();
          });
        }

        if (this.galleryModal) {
          this.galleryModal.addEventListener('click', (e) => {
            if (e.target === this.galleryModal) {
              this.closeGallery();
            }
          });
        }
      }

