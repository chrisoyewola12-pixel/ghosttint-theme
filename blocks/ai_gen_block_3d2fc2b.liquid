          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/k2Tk53P2Xx.jpg?v=1764861746',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/jG5-nh51k.jpg?v=1764861745',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/NcA2MNyEEG.jpg?v=1764861738',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/qXXHdf2Gs.jpg?v=1764861736',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/ipgoDEOo25X.jpg?v=1764861735',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/3fTFlCMEn.jpg?v=1764861733',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/rw1bmLBHP.jpg?v=1764861725',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/aHMn93pE6.jpg?v=1764861724',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/dHlN2jETZX.jpg?v=1764861722',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/I9pZNNBg-B2.jpg?v=1764861712',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/X72iGppIswF.jpg?v=1764861707',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/9OnBbsFqP.jpg?v=1764861695',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/unqmIaq33M.jpg?v=1764861692',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/OhuyfKNE4UY.jpg?v=1764861691',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/EZhWzc3W4o.jpg?v=1764861689',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/BQejmk9Pe.jpg?v=1764861682',
          'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/bNoVvE5wX.jpg?v=1764861678'
        ];

        const sampleReviews = [];
        const totalReviews = Math.max({{ block.settings.sample_review_count }}, imageUrls.length);

        for (let i = 0; i < totalReviews; i++) {
          const rating = 5;
          const hasImage = i < imageUrls.length;
          const hasReply = Math.random() > 0.7;
          const daysAgo = Math.floor(Math.random() * 180);
          const date = new Date();
          date.setDate(date.getDate() - daysAgo);

          sampleReviews.push({
            id: i + 1,
            author: names[i % names.length],
            rating: rating,
            text: reviewTexts[i % reviewTexts.length],
            date: date,
            dateString: this.formatDate(date),
            verified: true,
            image: hasImage ? imageUrls[i] : null,
            productName: 'Clenova™ Lite 13L - Compact Smart Self Sealing Trash Bin',
            productImage: 'https://cdn.shopify.com/s/files/1/0945/8905/9420/files/royal-bin-signature-product-images-10_084ee349-ec47-4dd0-8e5e-f05294275961.webp?v=1764696264',
            productUrl: '#',
            reply: hasReply ? replies[i % replies.length] : null
          });
        }

        return sampleReviews;
      }

      formatDate(date) {
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        return date.toLocaleDateString('en-US', options);
      }

      filterAndRenderReviews() {
        this.filteredReviews = [...this.reviews];

        switch (this.currentFilter) {
          case 'newest':
            this.filteredReviews.sort((a, b) => b.date - a.date);
            break;
          case 'oldest':
            this.filteredReviews.sort((a, b) => a.date - b.date);
            break;
          case 'highest':
            this.filteredReviews.sort((a, b) => b.rating - a.rating);
            break;
          case 'lowest':
            this.filteredReviews.sort((a, b) => a.rating - b.rating);
            break;
        }

        this.currentPage = 1;
        this.renderReviews(false);
      }

      renderReviews(append = false) {
        if (this.loadingState) {
          this.loadingState.style.display = 'none';
        }

        if (this.filteredReviews.length === 0) {
          this.grid.style.display = 'none';
          this.emptyState.style.display = 'block';
          if (this.loadMoreContainer) {
            this.loadMoreContainer.style.display = 'none';
          }
          return;
        }

        this.grid.style.display = 'grid';
        this.emptyState.style.display = 'none';

        const startIndex = append ? (this.currentPage - 1) * this.reviewsPerPage : 0;
        const endIndex = this.currentPage * this.reviewsPerPage;
        const reviewsToShow = this.filteredReviews.slice(startIndex, endIndex);

        if (!append) {
          this.grid.innerHTML = '';
        }

        reviewsToShow.forEach(review => {
          this.grid.insertAdjacentHTML('beforeend', this.createReviewCard(review));
        });

        this.updateReviewCount();
        this.updateLoadMoreButton();
        this.attachImageListeners();
      }

      createReviewCard(review) {
        const stars = '★'.repeat(review.rating) + '☆'.repeat(5 - review.rating);

        return `
          <div class="ai-review-card-{{ ai_gen_id }}">
            <div class="ai-review-header-{{ ai_gen_id }}">
              <div class="ai-review-author-{{ ai_gen_id }}">
                <div class="ai-review-author-name-{{ ai_gen_id }}">
                  ${review.author}
                  ${review.verified ? '<span class="ai-review-verified-{{ ai_gen_id }}">✓ Verified</span>' : ''}
                </div>
                <div class="ai-review-date-{{ ai_gen_id }}">${review.dateString}</div>
              </div>
              <div class="ai-review-rating-{{ ai_gen_id }}">${stars}</div>
            </div>

            ${review.image ? `
              <div class="ai-review-image-{{ ai_gen_id }}" data-review-image="${review.image}">
                <img src="${review.image}" alt="Customer photo" loading="lazy">
              </div>
            ` : ''}

            <div class="ai-review-text-{{ ai_gen_id }}">
              ${review.text}
            </div>

            ${review.reply ? `
              <div class="ai-review-reply-{{ ai_gen_id }}">
                <span class="ai-review-reply-label-{{ ai_gen_id }}">Store replied:</span>
                <div class="ai-review-reply-text-{{ ai_gen_id }}">${review.reply}</div>
              </div>
            ` : ''}

            <div class="ai-review-product-{{ ai_gen_id }}">
              <div class="ai-review-product-image-{{ ai_gen_id }}">
                <img src="${review.productImage}" alt="${review.productName}" loading="lazy">
              </div>
              <div class="ai-review-product-info-{{ ai_gen_id }}">
                <a href="${review.productUrl}" class="ai-review-product-name-{{ ai_gen_id }}">
                  ${review.productName}
                </a>
              </div>
            </div>
          </div>
        `;
      }

      updateReviewCount() {
        if (this.reviewCount) {
          const count = this.filteredReviews.length;
          this.reviewCount.textContent = `${count} review${count !== 1 ? 's' : ''}`;
        }
      }

      updateLoadMoreButton() {
        if (!this.loadMoreContainer || !this.loadMoreBtn) return;

        const totalPages = Math.ceil(this.filteredReviews.length / this.reviewsPerPage);

        if (this.currentPage >= totalPages) {
          this.loadMoreContainer.style.display = 'none';
        } else {
          this.loadMoreContainer.style.display = 'block';
        }
      }

      attachImageListeners() {
        const images = this.querySelectorAll('[data-review-image]');
        images.forEach(img => {
          img.addEventListener('click', () => {
            this.openGallery(img.dataset.reviewImage);
          });
        });
      }

      openGallery(imageSrc) {
        if (this.galleryModal && this.galleryImage) {
          this.galleryImage.src = imageSrc;
          this.galleryModal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }

      closeGallery() {
        if (this.galleryModal) {
          this.galleryModal.classList.remove('active');
          document.body.style.overflow = '';
        }
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

