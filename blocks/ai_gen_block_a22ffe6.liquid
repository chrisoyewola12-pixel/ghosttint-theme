{% doc %}
  @prompt
    Create a responsive FAQ accordion section titled “Still Have Questions?”
    Center the headline in large bold navy text (#002B5B) with generous top and bottom spacing on both desktop and mobile.
    
    Below the headline add a stacked accordion with rounded pill-style headers (border-radius ~24px), solid navy background (#032B5B), white text, and left-aligned line icons for each category plus a right-aligned + / – toggle icon. Headers should be tall and padded for easy tapping on mobile.
    
    Accordion sections:
    
    Refill Ring Features
    Q: How many bags are in one refill ring?
    A: About 25 self-sealing bags per ring — up to 1 month depending on use.
    Q: Are the bags scented or unscented?
    A: Unscented by default — odor is sealed inside.
    Q: Will this fit both Trash King bins?
    A: Yes — choose your size: Signature 17L or Lite 13L.
    Q: Can I use my own trash bags?
    A: You can, but you’ll lose the auto-seal + auto-reload features.
    
    Materials & Care
    Q: Are refill rings recyclable?
    A: Yes — both the ring and bag film are made from recyclable materials.
    Q: How do I know when to replace the ring?
    A: A red tab appears when the ring is nearly empty.
    Q: Do I need to clean anything between swaps?
    A: No — bags seal and drop away cleanly with zero mess.
    
    Shipping
    Q: Do I get refills automatically?
    A: Yes — subscriptions auto-ship your next refill so you never run out.
    Q: Can I cancel or skip?
    A: Anytime — skip, pause, or cancel in one tap.
    Q: How fast is shipping?
    A: Ships in 1–2 business days; delivery in 3–6 days (US).
    Q: Do you offer free shipping?
    A: Yes — subscriptions ship free, and one-time orders ship free over $150+.
    
    Layout rules
    
    Desktop
    
    FAQ container centered with max width ~900–1000px.
    
    Accordions stacked vertically with generous vertical spacing.
    
    Rounded navy headers remain pill-shaped.
    
    Expanded content shown in clean white panels below headers with comfortable paragraph spacing (not cramped).
    
    Mobile
    
    Headline remains centered and visible first.
    
    Accordion headers expand to full widt
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-faq-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-faq-headline-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_bottom_spacing }}px;
    line-height: 1.2;
  }

  .ai-faq-accordions-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.accordion_spacing }}px;
  }

  .ai-faq-category-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-faq-category-header-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.header_bg_color }};
    color: {{ block.settings.header_text_color }};
    border: none;
    border-radius: {{ block.settings.header_border_radius }}px;
    padding: {{ block.settings.header_padding_vertical }}px {{ block.settings.header_padding_horizontal }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: left;
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: 600;
  }

  .ai-faq-category-header-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-faq-header-left-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-faq-category-icon-{{ ai_gen_id }} {
    width: {{ block.settings.category_icon_size }}px;
    height: {{ block.settings.category_icon_size }}px;
    flex-shrink: 0;
  }

  .ai-faq-category-title-{{ ai_gen_id }} {
    font-size: inherit;
    font-weight: inherit;
    margin: 0;
  }

  .ai-faq-toggle-icon-{{ ai_gen_id }} {
    width: {{ block.settings.toggle_icon_size }}px;
    height: {{ block.settings.toggle_icon_size }}px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .ai-faq-category-{{ ai_gen_id }}.active .ai-faq-toggle-icon-{{ ai_gen_id }} {
    transform: rotate(45deg);
  }

  .ai-faq-category-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .ai-faq-category-{{ ai_gen_id }}.active .ai-faq-category-content-{{ ai_gen_id }} {
    max-height: 2000px;
  }

  .ai-faq-questions-{{ ai_gen_id }} {
    background-color: {{ block.settings.content_bg_color }};
    border-radius: 0 0 {{ block.settings.header_border_radius }}px {{ block.settings.header_border_radius }}px;
    padding: {{ block.settings.content_padding }}px;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.question_spacing }}px;
  }

  .ai-faq-question-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-faq-q-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.question_color }};
    margin: 0 0 8px;
    font-size: {{ block.settings.question_font_size }}px;
  }

  .ai-faq-a-{{ ai_gen_id }} {
    color: {{ block.settings.answer_color }};
    margin: 0;
    line-height: 1.6;
    font-size: {{ block.settings.answer_font_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-faq-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_padding_top }}px 16px {{ block.settings.mobile_section_padding_bottom }}px;
    }

    .ai-faq-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_headline_size }}px;
      margin-bottom: {{ block.settings.mobile_headline_bottom_spacing }}px;
    }

    .ai-faq-category-header-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_header_padding_vertical }}px {{ block.settings.mobile_header_padding_horizontal }}px;
      font-size: {{ block.settings.mobile_header_font_size }}px;
    }

    .ai-faq-questions-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_content_padding }}px;
    }

    .ai-faq-q-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_question_font_size }}px;
    }

    .ai-faq-a-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_answer_font_size }}px;
    }
  }
{% endstyle %}

