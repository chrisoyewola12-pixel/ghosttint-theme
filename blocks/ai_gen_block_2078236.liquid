        <button
          class="ai-faq-question-button-{{ ai_gen_id }}"
          aria-expanded="false"
          aria-controls="ai-faq-answer-1-{{ ai_gen_id }}"
          data-faq-button
        >
          <span class="ai-faq-question-text-{{ ai_gen_id }}">{{ block.settings.question_1 }}</span>
          <svg class="ai-faq-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div
          id="ai-faq-answer-1-{{ ai_gen_id }}"
          class="ai-faq-answer-{{ ai_gen_id }}"
          role="region"
        >
          <div class="ai-faq-answer-content-{{ ai_gen_id }}">
