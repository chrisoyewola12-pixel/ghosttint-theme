{% doc %}
  @prompt
    Wide horizontal website banner with a bold, solid red background. Centered white uppercase headline text reads “HOLIDAY SALE NOW LIVE” in a strong sans-serif font, with smaller subtext beneath saying “UP TO 57% OFF + EXCLUSIVE OFFERS.” On the right side, a clean countdown timer displays three white number blocks labeled “HOURS,” “MINUTES,” and “SECONDS,” with large digits above each label. Minimal, high-contrast, modern e-commerce promotional design, flat layout, no gradients or textures, optimized for a sale announcement header.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-holiday-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 20px;
  }

  .ai-holiday-banner-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .ai-holiday-banner-content-{{ ai_gen_id }} {
    flex: 1;
    text-align: center;
  }

  .ai-holiday-banner-headline-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-holiday-banner-subtext-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtext_size }}px;
    font-weight: 400;
    margin: 0;
    opacity: 0.95;
  }

  .ai-holiday-banner-timer-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.timer_gap }}px;
    align-items: center;
  }

  .ai-holiday-banner-timer-block-{{ ai_gen_id }} {
    background-color: {{ block.settings.timer_block_bg }};
    border-radius: {{ block.settings.timer_border_radius }}px;
    padding: {{ block.settings.timer_padding_vertical }}px {{ block.settings.timer_padding_horizontal }}px;
    min-width: {{ block.settings.timer_min_width }}px;
    text-align: center;
  }

  .ai-holiday-banner-timer-number-{{ ai_gen_id }} {
    color: {{ block.settings.timer_number_color }};
    font-size: {{ block.settings.timer_number_size }}px;
    font-weight: 700;
    line-height: 1;
    display: block;
    margin-bottom: 4px;
  }

  .ai-holiday-banner-timer-label-{{ ai_gen_id }} {
    color: {{ block.settings.timer_label_color }};
    font-size: {{ block.settings.timer_label_size }}px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-holiday-banner-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
    }

    .ai-holiday-banner-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-holiday-banner-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }

    .ai-holiday-banner-timer-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.timer_number_size | times: 0.8 }}px;
    }

    .ai-holiday-banner-timer-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.timer_label_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-holiday-banner-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px 15px;
    }

    .ai-holiday-banner-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.6 }}px;
    }

    .ai-holiday-banner-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.8 }}px;
    }

    .ai-holiday-banner-timer-{{ ai_gen_id }} {
      gap: {{ block.settings.timer_gap | times: 0.7 }}px;
    }

    .ai-holiday-banner-timer-block-{{ ai_gen_id }} {
      padding: {{ block.settings.timer_padding_vertical | times: 0.7 }}px {{ block.settings.timer_padding_horizontal | times: 0.7 }}px;
      min-width: {{ block.settings.timer_min_width | times: 0.7 }}px;
    }

    .ai-holiday-banner-timer-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.timer_number_size | times: 0.6 }}px;
    }

    .ai-holiday-banner-timer-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.timer_label_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<holiday-sale-banner-{{ ai_gen_id }}
  class="ai-holiday-banner-{{ ai_gen_id }}"
  data-end-date="{{ block.settings.end_date }}"
  data-end-time="{{ block.settings.end_time }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-holiday-banner-container-{{ ai_gen_id }}">
    <div class="ai-holiday-banner-content-{{ ai_gen_id }}">
      {% if block.settings.headline != blank %}
        <h2 class="ai-holiday-banner-headline-{{ ai_gen_id }}">
          {{ block.settings.headline }}
        </h2>
      {% endif %}
      {% if block.settings.subtext != blank %}
        <p class="ai-holiday-banner-subtext-{{ ai_gen_id }}">
          {{ block.settings.subtext }}
        </p>
      {% endif %}
    </div>

    <div class="ai-holiday-banner-timer-{{ ai_gen_id }}">
      <div class="ai-holiday-banner-timer-block-{{ ai_gen_id }}">
        <span class="ai-holiday-banner-timer-number-{{ ai_gen_id }}" data-timer-hours>00</span>
        <span class="ai-holiday-banner-timer-label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</span>
      </div>
      <div class="ai-holiday-banner-timer-block-{{ ai_gen_id }}">
        <span class="ai-holiday-banner-timer-number-{{ ai_gen_id }}" data-timer-minutes>00</span>
        <span class="ai-holiday-banner-timer-label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</span>
      </div>
      <div class="ai-holiday-banner-timer-block-{{ ai_gen_id }}">
        <span class="ai-holiday-banner-timer-number-{{ ai_gen_id }}" data-timer-seconds>00</span>
        <span class="ai-holiday-banner-timer-label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</span>
      </div>
    </div>
  </div>
</holiday-sale-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class HolidaySaleBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.endDate = this.dataset.endDate;
        this.endTime = this.dataset.endTime;
        this.hoursElement = this.querySelector('[data-timer-hours]');
        this.minutesElement = this.querySelector('[data-timer-minutes]');
        this.secondsElement = this.querySelector('[data-timer-seconds]');
      }

      connectedCallback() {
        if (this.endDate && this.endTime) {
          this.startCountdown();
        }
      }

      startCountdown() {
        const updateTimer = () => {
          const now = new Date().getTime();
          const endDateTime = new Date(this.endDate + ' ' + this.endTime).getTime();
          const distance = endDateTime - now;

          if (distance < 0) {
            this.hoursElement.textContent = '00';
            this.minutesElement.textContent = '00';
            this.secondsElement.textContent = '00';
            return;
          }

          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          this.hoursElement.textContent = String(hours).padStart(2, '0');
          this.minutesElement.textContent = String(minutes).padStart(2, '0');
          this.secondsElement.textContent = String(seconds).padStart(2, '0');
        };

        updateTimer();
        this.interval = setInterval(updateTimer, 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }
    }

    customElements.define('holiday-sale-banner-{{ ai_gen_id }}', HolidaySaleBanner{{ ai_gen_id }});
  })();
</script>

