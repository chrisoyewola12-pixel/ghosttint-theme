{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-block-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    max-width: 100%;
  }

  .ai-comparison-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
    padding-right: 40px;
  }

  .ai-comparison-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    line-height: 1.2;
    margin: 0;
  }

  .ai-comparison-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_size }}px;
    color: {{ block.settings.subtext_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-comparison-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 9999px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-comparison-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  .ai-comparison-right-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    background-color: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .ai-comparison-products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 30px 20px;
    border-bottom: 1px solid #e5e5e5;
  }

  .ai-comparison-product-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .ai-comparison-product-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .ai-comparison-product-image-wrapper-{{ ai_gen_id }}.royal-bin {
    border: 2px solid {{ block.settings.headline_color }};
  }

  .ai-comparison-product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-comparison-product-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-comparison-product-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-comparison-product-label-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 700;
    color: {{ block.settings.headline_color }};
    text-align: center;
  }

  .ai-comparison-features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-comparison-feature-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 20px;
    padding: 16px 20px;
    border-bottom: 1px solid #f0f0f0;
    align-items: center;
  }

  .ai-comparison-feature-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-comparison-feature-label-{{ ai_gen_id }} {
    font-size: 13px;
    font-weight: 600;
    color: #333333;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-comparison-feature-value-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-comparison-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
  }

  .ai-comparison-icon-check-{{ ai_gen_id }} {
    color: #00C853;
  }

  .ai-comparison-icon-cross-{{ ai_gen_id }} {
    color: #FF1744;
  }

  .ai-comparison-icon-dash-{{ ai_gen_id }} {
    color: #FFC107;
  }

  @media screen and (max-width: 989px) {
    .ai-comparison-block-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-comparison-left-{{ ai_gen_id }} {
      padding-right: 0;
      text-align: center;
      align-items: center;
    }

    .ai-comparison-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.8 }}px;
    }

    .ai-comparison-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-products-{{ ai_gen_id }} {
      gap: 12px;
      padding: 20px 12px;
    }

    .ai-comparison-feature-row-{{ ai_gen_id }} {
      grid-template-columns: 1.5fr repeat(3, 1fr);
      gap: 8px;
      padding: 12px 12px;
    }

    .ai-comparison-feature-label-{{ ai_gen_id }} {
      font-size: 11px;
    }

    .ai-comparison-icon-{{ ai_gen_id }} {
      width: 20px;
      height: 20px;
    }

    .ai-comparison-product-label-{{ ai_gen_id }} {
      font-size: 12px;
    }

    .ai-comparison-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.6 }}px;
    }

    .ai-comparison-button-{{ ai_gen_id }} {
      padding: 14px 32px;
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-left-{{ ai_gen_id }}">
    {% if block.settings.headline != blank %}
      <h2 class="ai-comparison-headline-{{ ai_gen_id }}">
        {{ block.settings.headline }}
      </h2>
    {% endif %}

    {% if block.settings.subtext != blank %}
      <div class="ai-comparison-subtext-{{ ai_gen_id }}">
        {{ block.settings.subtext }}
      </div>
    {% endif %}

    {% if block.settings.button_text != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-comparison-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>

  <div class="ai-comparison-right-{{ ai_gen_id }}">
    <div class="ai-comparison-table-{{ ai_gen_id }}">
      <div class="ai-comparison-products-{{ ai_gen_id }}">
        <div class="ai-comparison-product-{{ ai_gen_id }}">
          <div class="ai-comparison-product-image-wrapper-{{ ai_gen_id }} royal-bin">
            {% if block.settings.product_1_image %}
              <img
                src="{{ block.settings.product_1_image | image_url: width: 400 }}"
                alt="{{ block.settings.product_1_label }}"
                class="ai-comparison-product-image-{{ ai_gen_id }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% else %}
              <div class="ai-comparison-product-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-comparison-product-label-{{ ai_gen_id }}">
            {{ block.settings.product_1_label }}
          </div>
        </div>

        <div class="ai-comparison-product-{{ ai_gen_id }}">
          <div class="ai-comparison-product-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.product_2_image %}
              <img
                src="{{ block.settings.product_2_image | image_url: width: 400 }}"
                alt="{{ block.settings.product_2_label }}"
                class="ai-comparison-product-image-{{ ai_gen_id }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% else %}
              <div class="ai-comparison-product-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-comparison-product-label-{{ ai_gen_id }}">
            {{ block.settings.product_2_label }}
          </div>
        </div>

        <div class="ai-comparison-product-{{ ai_gen_id }}">
          <div class="ai-comparison-product-image-wrapper-{{ ai_gen_id }}">
            {% if block.settings.product_3_image %}
              <img
                src="{{ block.settings.product_3_image | image_url: width: 400 }}"
                alt="{{ block.settings.product_3_label }}"
                class="ai-comparison-product-image-{{ ai_gen_id }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {% else %}
              <div class="ai-comparison-product-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-comparison-product-label-{{ ai_gen_id }}">
            {{ block.settings.product_3_label }}
          </div>
        </div>
      </div>

      <div class="ai-comparison-features-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign feature_label_key = 'feature_' | append: i | append: '_label'
            assign feature_p1_key = 'feature_' | append: i | append: '_product_1'
            assign feature_p2_key = 'feature_' | append: i | append: '_product_2'
            assign feature_p3_key = 'feature_' | append: i | append: '_product_3'

            assign feature_label = block.settings[feature_label_key]
            assign feature_p1 = block.settings[feature_p1_key]
            assign feature_p2 = block.settings[feature_p2_key]
            assign feature_p3 = block.settings[feature_p3_key]
          %}

          {% if feature_label != blank %}
            <div class="ai-comparison-feature-row-{{ ai_gen_id }}">
              <div class="ai-comparison-feature-label-{{ ai_gen_id }}">
                {{ feature_label }}
              </div>

              <div class="ai-comparison-feature-value-{{ ai_gen_id }}">
                {% if feature_p1 == 'check' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-check-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% elsif feature_p1 == 'cross' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-cross-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                {% elsif feature_p1 == 'dash' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-dash-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                {% endif %}
              </div>

              <div class="ai-comparison-feature-value-{{ ai_gen_id }}">
                {% if feature_p2 == 'check' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-check-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% elsif feature_p2 == 'cross' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-cross-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                {% elsif feature_p2 == 'dash' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-dash-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                {% endif %}
              </div>

              <div class="ai-comparison-feature-value-{{ ai_gen_id }}">
                {% if feature_p3 == 'check' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-check-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {% elsif feature_p3 == 'cross' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-cross-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                {% elsif feature_p3 == 'dash' %}
                  <svg class="ai-comparison-icon-{{ ai_gen_id }} ai-comparison-icon-dash-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

